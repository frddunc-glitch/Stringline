<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Stringline.Graph</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stringline.Core\Stringline.Core.csproj" />
    <ProjectReference Include="..\Stringline.Network\Stringline.Network.csproj" />
    <ProjectReference Include="..\Stringline.Planning\Stringline.Planning.csproj" />
    <!-- A draft board's drags become timetable edits (S44). -->
    <ProjectReference Include="..\Stringline.Timetable\Stringline.Timetable.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <!-- SkiaSharp brings Windows and macOS natives; Linux (CI, cloud sessions, headless render-png) needs its own. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <!-- Noto Sans, SIL Open Font Licence 1.1 (Fonts/OFL.txt). -->
    <EmbeddedResource Include="Fonts\*.ttf" LogicalName="Stringline.Graph.Fonts.%(Filename)%(Extension)" />
    <None Include="Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" Link="Fonts\OFL-NotoSans.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Stringline.Graph.Tests" />
  </ItemGroup>

</Project>
