<UserControl x:Class="Stringline.App.Controls.GraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
             Focusable="True" FocusVisualStyle="{x:Null}">
  <Grid x:Name="Root" Background="White">
    <skia:SKElement x:Name="Surface" PaintSurface="OnPaintSurface" />
    <Popup x:Name="Tip" PlacementTarget="{Binding ElementName=Surface}" Placement="Relative"
           AllowsTransparency="True" IsHitTestVisible="False" Focusable="False">
      <Border Background="#F7FFFFFF" BorderBrush="#9E9E9E" BorderThickness="1" Padding="8,6" CornerRadius="3">
        <StackPanel>
          <TextBlock x:Name="TipHeading" FontWeight="SemiBold" Margin="0,0,0,4" />
          <ItemsControl x:Name="TipLines">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Label}" Foreground="#757575" />
                  <TextBlock Grid.Column="1" Text="{Binding Value}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
