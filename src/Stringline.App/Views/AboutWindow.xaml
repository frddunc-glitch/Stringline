<Window x:Class="Stringline.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Stringline.App.Services"
        Title="About Stringline" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style TargetType="TextBlock" x:Key="Small">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="#616161" />
      <Setter Property="FontSize" Value="11" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="View _licence" Padding="8,2" Margin="0,0,6,0" Click="OnViewLicence" />
      <Button Content="Copy _version" Padding="8,2" Margin="0,0,6,0" Click="OnCopyVersion" />
      <Button Content="Close" IsCancel="True" IsDefault="True" Width="80" />
    </StackPanel>

    <StackPanel>
      <DockPanel>
        <Image x:Name="Logo" Width="64" Height="64" Margin="0,0,14,0" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel>
          <TextBlock x:Name="ProductText" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="A live electronic train graph for SimSig." Margin="0,2,0,0" />
          <TextBlock x:Name="CopyrightText" Margin="0,6,0,0" />
        </StackPanel>
      </DockPanel>

      <TextBlock x:Name="WarrantyText" Margin="0,12,0,0" />
      <TextBlock Margin="0,8,0,0">
        <Run Text="Licence:" />
        <Hyperlink x:Name="LicenceLink" RequestNavigate="OnNavigate"><Run x:Name="LicenceText" /></Hyperlink>
      </TextBlock>
      <TextBlock Margin="0,4,0,0">
        <Run Text="Source code:" />
        <Hyperlink x:Name="SourceLink" RequestNavigate="OnNavigate"><Run x:Name="SourceText" /></Hyperlink>
      </TextBlock>
      <TextBlock Margin="0,4,0,0">
        <Run Text="Privacy: Stringline sends nothing anywhere except to the SimSig gateway you connect to." />
        <Hyperlink x:Name="PrivacyLink" Command="ApplicationCommands.Help" CommandParameter="{x:Static services:HelpTopics.Privacy}"><Run Text="What it stores" /></Hyperlink>
      </TextBlock>

      <TextBlock Text="Built with" FontWeight="SemiBold" Margin="0,14,0,4" />
      <ItemsControl x:Name="CreditList" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Margin="0,1">
              <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="OnNavigate"><Run Text="{Binding Name, Mode=OneWay}" /></Hyperlink>
              <Run Text="{Binding Licence, Mode=OneWay, StringFormat='— {0}'}" Foreground="#616161" />
              <Run Text="{Binding What, Mode=OneWay, StringFormat='({0})'}" Foreground="#9E9E9E" />
            </TextBlock>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock x:Name="DisclaimerText" Style="{StaticResource Small}" Margin="0,14,0,0" />
    </StackPanel>
  </DockPanel>
</Window>
