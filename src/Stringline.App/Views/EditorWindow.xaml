<Window x:Class="Stringline.App.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Stringline.App.Views"
        xmlns:controls="clr-namespace:Stringline.App.Controls"
        xmlns:services="clr-namespace:Stringline.App.Services"
        views:Help.Topic="{x:Static services:HelpTopics.TimetableEditor}"
        Title="{Binding Title}" Icon="pack://application:,,,/Stringline;component/Assets/stringline.ico"
        Width="1360" Height="940" MinWidth="760" MinHeight="560"
        UseLayoutRounding="True" WindowStartupLocation="CenterOwner">
  <!-- The timetable editor workspace (S43, 08-…md §7): trains, the selected train's details and trip grid, the header,
       the draft board (S44) and the issues. A window of its own, like a board window (S21), so it can sit on a second
       monitor. -->
  <Window.Resources>
    <views:NotNullToVisibilityConverter x:Key="NotNull" />
    <views:IssueSeverityBrushConverter x:Key="SeverityBrush" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="CanUserReorderColumns" Value="False" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0" />
      <Setter Property="RowHeaderWidth" Value="0" />
      <Setter Property="EnableRowVirtualization" Value="True" />
    </Style>
    <Style TargetType="TextBlock" x:Key="Hint">
      <Setter Property="Foreground" Value="#757575" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <!-- A labelled box in the train's details -->
    <Style TargetType="Label">
      <Setter Property="Padding" Value="0,0,4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="TextBox" x:Key="Detail">
      <Setter Property="Width" Value="90" />
      <Setter Property="Margin" Value="0,1,12,1" />
      <Setter Property="Padding" Value="2,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- One group of the train's details (#25) -->
    <Style TargetType="GroupBox" x:Key="DetailGroup">
      <Setter Property="Margin" Value="0,0,8,4" />
      <Setter Property="Padding" Value="6,2,6,0" />
      <Setter Property="BorderBrush" Value="#D0D0D0" />
      <Setter Property="HeaderTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" FontWeight="SemiBold" Foreground="#424242" />
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- The unit after a box: mph, m, % -->
    <Style TargetType="TextBlock" x:Key="Unit">
      <Setter Property="Foreground" Value="#757575" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="-9,0,12,0" />
    </Style>
    <!-- The issue mark at the start of a row: a dot in the worst issue's colour, the issues on hover -->
    <DataTemplate x:Key="IssueMark">
      <TextBlock Text="●" HorizontalAlignment="Center" Foreground="{Binding Worst, Converter={StaticResource SeverityBrush}}"
                 ToolTip="{Binding IssueTip}" ToolTipService.ShowDuration="60000" />
    </DataTemplate>
    <!-- An editable drop-down for a code cell: typed text with completion from the codes other timetables use -->
    <Style TargetType="ComboBox" x:Key="CodeBox">
      <Setter Property="IsEditable" Value="True" />
      <Setter Property="IsTextSearchEnabled" Value="True" />
      <Setter Property="TextSearch.TextPath" Value="Code" />
      <Setter Property="StaysOpenOnEdit" Value="True" />
      <Setter Property="ItemTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel>
    <Menu DockPanel.Dock="Top" x:Name="EditorMenu">
      <MenuItem Header="_Draft">
        <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveDraftCommand}" />
        <MenuItem Header="Save _as…" Command="{Binding SaveDraftAsCommand}" />
        <MenuItem Header="_Release version…" Command="{Binding ReleaseVersionCommand}"
                  ToolTip="Raise the minor or major version number (the build goes back to 0) and save" />
        <Separator />
        <MenuItem Header="C_heck timetable" InputGestureText="F7" Command="{Binding CheckAllCommand}" />
        <Separator />
        <MenuItem Header="E_xport graph">
          <MenuItem Header="_PNG image…" Command="{Binding Board.ExportPngCommand}" ToolTip="The draft board as shown" />
          <MenuItem Header="P_DF (A3)…" Command="{Binding Board.ExportPdfCommand}" ToolTip="The draft board as shown, on A3 landscape" />
          <MenuItem Header="Pl_ot (multi-page PDF)…" Command="{Binding Board.ExportPlotCommand}" ToolTip="A corridor of the draft over a stretch of time" />
        </MenuItem>
        <Separator />
        <MenuItem Header="Test in Si_mSig…" Command="{Binding ShowTestStepsCommand}" ToolTip="How to test the draft in SimSig and read the run back" />
        <MenuItem Header="Test re_port from a recording…" Command="{Binding TestReportCommand}"
                  ToolTip="A recording of the timetable running in SimSig, read against the draft: what went wrong shows in the Issues panel" />
        <MenuItem Header="Cl_ear test report" Command="{Binding ClearTestReportCommand}" />
        <Separator />
        <MenuItem Header="Export _trains (CSV)…" Command="{Binding ExportCsvCommand}" ToolTip="Every train as a spreadsheet, one row per timing point" />
        <MenuItem Header="_Import trains (CSV)…" Command="{Binding ImportCsvCommand}" ToolTip="Merge a spreadsheet back in: changed trains by UID, else headcode and first time; new ones added" />
        <Separator />
        <MenuItem Header="_Close draft" Command="{Binding CloseDraftCommand}" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="{Binding UndoHeader}" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
        <MenuItem Header="{Binding RedoHeader}" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
        <Separator />
        <MenuItem Header="_New train…" Command="{Binding NewTrainCommand}" />
        <MenuItem Header="_Copy train…" Command="{Binding CopyTrainCommand}" />
        <MenuItem Header="_Delete trains…" Command="{Binding DeleteTrainsCommand}" />
        <Separator />
        <MenuItem Header="_Insert point above" InputGestureText="Insert" Command="{Binding Train.InsertPointCommand}" />
        <MenuItem Header="Insert point _below" Command="{Binding Train.InsertPointAfterCommand}" />
        <MenuItem Header="Re_move points" InputGestureText="Ctrl+Delete" Command="{x:Static views:EditorWindow.DeletePointsCommand}" />
        <MenuItem Header="_Fill down" InputGestureText="Ctrl+D" Command="{x:Static views:EditorWindow.FillDownCommand}" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Draft _ghosts">
          <MenuItem Header="_Original timetable" Command="{Binding Board.ToggleOriginalCommand}" IsChecked="{Binding Board.ShowOriginal, Mode=OneWay}"
                    ToolTip="The original timetable's lines of the trains the draft changed, faint under the draft's" />
          <MenuItem Header="_Recording…" Command="{Binding Board.LoadRecordingCommand}"
                    ToolTip="Where a recording's (or saved session's) trains really ran, faint, matched against the draft" />
          <MenuItem Header="_Clear recording" Command="{Binding Board.ClearRecordingCommand}" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Bulk" ToolTip="Tools for the trains selected in the list: each shows what it would change before it does it, and is one undo">
        <MenuItem Header="_Shift times…" Command="{Binding ShiftTimesCommand}" />
        <MenuItem Header="_Renumber…" Command="{Binding RenumberTrainsCommand}" />
        <MenuItem Header="Change _category…" Command="{Binding ChangeCategoryCommand}" />
        <MenuItem Header="Platform, line or pat_h at a location…" Command="{Binding SetCodeAtLocationCommand}" />
        <MenuItem Header="_Allowances…" Command="{Binding SetAllowancesCommand}" />
        <MenuItem Header="_Find and replace…" Command="{Binding FindReplaceCommand}" />
        <Separator />
        <MenuItem Header="Repeat as _pattern…" Command="{Binding RepeatPatternCommand}" />
        <MenuItem Header="Pair _next workings…" Command="{Binding PairNextWorkingsCommand}" />
        <Separator />
        <MenuItem Header="Auto-fill _timings" Command="{Binding AutoFillCommand}" ToolTip="Time the untimed points from the sim's run times for each train's speed" />
        <MenuItem Header="Set _lines" Command="{Binding SetLinesCommand}" ToolTip="Give points with no line the line other timetables use there" />
        <MenuItem Header="_Insert timing points" Command="{Binding InsertTimingPointsCommand}" ToolTip="Add the points other timetables book where SimSig may find no path" />
      </MenuItem>
    </Menu>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock Text="{Binding IssueSummary}" FontWeight="SemiBold" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <Grid>
          <TextBlock Text="{Binding Error}" Foreground="#C62828" TextTrimming="CharacterEllipsis" ToolTip="{Binding Error}"
                     Visibility="{Binding Error, Converter={StaticResource NotNull}}" />
          <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileSummary}"
                     Visibility="{Binding Error, Converter={StaticResource NotNull}, ConverterParameter=invert}" />
        </Grid>
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <TextBlock Text="{Binding KnowledgeSummary}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="520"
                   ToolTip="{Binding KnowledgeSummary}" />
      </StatusBarItem>
    </StatusBar>

    <Grid Margin="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="400" MinWidth="220" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" MinWidth="320" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="3*" MinHeight="180" />
        <RowDefinition Height="6" />
        <RowDefinition Height="2*" MinHeight="140" />
        <RowDefinition Height="6" />
        <RowDefinition Height="160" MinHeight="80" />
      </Grid.RowDefinitions>

      <!-- Trains -->
      <DockPanel Grid.RowSpan="5" views:Help.Topic="{x:Static services:HelpTopics.TimetableEditorTrains}">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
          <Label Content="_Trains" Target="{Binding ElementName=TrainFilterBox}" FontWeight="SemiBold" />
          <CheckBox DockPanel.Dock="Right" Content="With _issues" VerticalAlignment="Center" IsChecked="{Binding IssuesOnly}"
                    ToolTip="Only trains with Errors or Warnings" />
          <TextBox x:Name="TrainFilterBox" Margin="4,0,8,0" Padding="2" Text="{Binding TrainFilter, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Filter by headcode, UID, entry time or place, category or seed group" />
        </DockPanel>
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
          <Button Content="New…" Command="{Binding NewTrainCommand}" />
          <Button Content="Copy…" Command="{Binding CopyTrainCommand}" />
          <Button Content="Delete…" Command="{Binding DeleteTrainsCommand}" />
        </WrapPanel>
        <DataGrid x:Name="TrainsGrid" ItemsSource="{Binding Trains}" SelectedItem="{Binding SelectedTrainRow}" SelectionMode="Extended"
                  IsReadOnly="True" CanUserSortColumns="True" SelectionChanged="OnTrainsSelectionChanged">
          <DataGrid.Columns>
            <DataGridTemplateColumn Width="18" CellTemplate="{StaticResource IssueMark}" SortMemberPath="Issues" />
            <DataGridTextColumn Header="Headcode" Binding="{Binding Headcode}" Width="70" />
            <DataGridTextColumn Header="UID" Binding="{Binding Uid}" Width="60" />
            <DataGridTextColumn Header="Entry" Binding="{Binding EntryTime}" SortMemberPath="EntrySeconds" Width="55" />
            <DataGridTextColumn Header="From" Binding="{Binding Entry}" Width="80" />
            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" />
            <DataGridTextColumn Header="Seed group" Binding="{Binding SeedGroup}" Width="60" />
            <DataGridTextColumn Header="Issues" Binding="{Binding Issues}" Width="45" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>

      <GridSplitter Grid.Column="1" Grid.RowSpan="5" Width="6" HorizontalAlignment="Stretch" />

      <TabControl Grid.Column="2" x:Name="Tabs">
        <!-- The selected train: details, then its trip grid -->
        <TabItem Header="Train" x:Name="TrainTab" views:Help.Topic="{x:Static services:HelpTopics.TimetableEditorTrips}">
          <Grid>
            <TextBlock Text="Choose a train in the list, or make one with New." Style="{StaticResource Hint}" Margin="12"
                       Visibility="{Binding Train, Converter={StaticResource NotNull}, ConverterParameter=invert}" />
            <DockPanel DataContext="{Binding Train}" Visibility="{Binding Converter={StaticResource NotNull}}" Margin="4">
              <!-- The train's details in four groups (#25): the cards wrap on a narrow window; the description group
                   takes the full width under them -->
              <StackPanel x:Name="DetailsPanel" DockPanel.Dock="Top" ToolTip="{Binding IssueTip}">
                <WrapPanel>
                  <GroupBox Header="Train" Style="{StaticResource DetailGroup}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Label Content="_Headcode" Target="{Binding ElementName=HeadcodeBox}" />
                      <TextBox x:Name="HeadcodeBox" Grid.Column="1" Style="{StaticResource Detail}" Width="60" Text="{Binding Headcode}"
                               FontWeight="SemiBold" ToolTip="Renumbering keeps the activities and rules that name this train" />
                      <Label Grid.Column="2" Content="UID" />
                      <TextBox Grid.Column="3" Style="{StaticResource Detail}" Width="70" Text="{Binding Uid}" />
                      <Label Grid.Row="1" Content="Category" />
                      <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Width="200" Margin="0,1,0,1" HorizontalAlignment="Left"
                                IsEditable="True" ItemsSource="{Binding CategoryChoices}"
                                TextSearch.TextPath="Code" Text="{Binding Category}" DisplayMemberPath="Label" />
                      <Label Grid.Row="2" Content="Operator" />
                      <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Detail}" Width="60" Text="{Binding OperatorCode}" />
                    </Grid>
                  </GroupBox>
                  <GroupBox Header="Entry and seeding" Style="{StaticResource DetailGroup}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Label Content="Entry point" />
                      <TextBox Grid.Column="1" Style="{StaticResource Detail}" Text="{Binding EntryPoint}" />
                      <Label Grid.Column="2" Content="Time" />
                      <TextBox Grid.Column="3" Style="{StaticResource Detail}" Width="60" Text="{Binding DepartTime}" ToolTip="The time the train enters, or is seeded" />
                      <Label Grid.Row="1" Content="Seed point" />
                      <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Detail}" Text="{Binding SeedPoint}" />
                      <Label Grid.Row="1" Grid.Column="2" Content="Gap" />
                      <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
                        <TextBox Style="{StaticResource Detail}" Width="45" Text="{Binding SeedingGap}" ToolTip="Seeding gap, metres" />
                        <TextBlock Style="{StaticResource Unit}" Text="m" />
                      </StackPanel>
                      <Label Grid.Row="2" Content="Seed group" />
                      <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Detail}" Width="60" Text="{Binding SeedGroup}"
                               ToolTip="The ID of a seed group on the Seed groups tab; empty to seed at the timetable's start" />
                    </Grid>
                  </GroupBox>
                  <GroupBox Header="Running" Style="{StaticResource DetailGroup}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Label Content="Max speed" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBox Style="{StaticResource Detail}" Width="45" Text="{Binding MaxSpeed}" ToolTip="mph; empty for the category's" />
                        <TextBlock Style="{StaticResource Unit}" Text="mph" />
                      </StackPanel>
                      <Label Grid.Row="1" Content="Length" />
                      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Style="{StaticResource Detail}" Width="45" Text="{Binding TrainLength}" ToolTip="metres; empty for the category's" />
                        <TextBlock Style="{StaticResource Unit}" Text="m" />
                      </StackPanel>
                      <Label Grid.Row="2" Content="As required" />
                      <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Style="{StaticResource Detail}" Width="45" Text="{Binding AsRequiredPercent}" ToolTip="The chance the train runs, per cent" />
                        <TextBlock Style="{StaticResource Unit}" Text="%" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Grid.RowSpan="2" Margin="4,0,0,0">
                        <CheckBox Content="Freight" Margin="0,3" IsChecked="{Binding IsFreight}" />
                        <CheckBox Content="Goods lines" Margin="0,3" IsChecked="{Binding CanUseGoodsLines}" ToolTip="The train may use goods lines" />
                      </StackPanel>
                    </Grid>
                  </GroupBox>
                </WrapPanel>
                <GroupBox Header="Description and journey" Style="{StaticResource DetailGroup}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" MinWidth="80" MaxWidth="220" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" MinWidth="80" MaxWidth="220" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="2*" MinWidth="80" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="_Description" Target="{Binding ElementName=DescriptionBox}" />
                    <TextBox x:Name="DescriptionBox" Grid.Column="1" Grid.ColumnSpan="5" Style="{StaticResource Detail}" Width="Auto"
                             Text="{Binding Description}" ToolTip="Free text, or $template to use the header's template" />
                    <TextBlock Grid.Column="6" Grid.ColumnSpan="2" VerticalAlignment="Center" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               Text="{Binding DescriptionPreview, StringFormat=Shows as: {0}}" ToolTip="{Binding DescriptionPreview}"
                               Visibility="{Binding UsesTemplate, Converter={StaticResource BoolToVisibility}}" />
                    <Label Grid.Row="1" Content="Origin" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Detail}" Width="Auto" Margin="0,1,4,1" Text="{Binding OriginName}" />
                    <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource Detail}" Width="55" Text="{Binding OriginTime}" ToolTip="Origin time" />
                    <Label Grid.Row="1" Grid.Column="3" Content="Destination" />
                    <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource Detail}" Width="Auto" Margin="0,1,4,1" Text="{Binding DestinationName}" />
                    <TextBox Grid.Row="1" Grid.Column="5" Style="{StaticResource Detail}" Width="55" Text="{Binding DestinationTime}" ToolTip="Destination time" />
                    <Label Grid.Row="1" Grid.Column="6" Content="Notes" />
                    <TextBox Grid.Row="1" Grid.Column="7" Style="{StaticResource Detail}" Width="Auto" Margin="0,1,0,1" Text="{Binding Notes}" />
                  </Grid>
                </GroupBox>
              </StackPanel>
              <TextBlock DockPanel.Dock="Top" Margin="4,2" Text="{Binding FormedBy}" FontStyle="Italic"
                         Visibility="{Binding FormedBy, Converter={StaticResource NotNull}}" />
              <!-- Activities of the point the grid is on (S45) -->
              <DockPanel DockPanel.Dock="Bottom" Height="110" Margin="0,6,0,0" views:Help.Topic="{x:Static services:HelpTopics.TimetableEditorActivities}">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                  <TextBlock Text="{Binding ActivitiesHeading}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <ComboBox Width="160" ItemsSource="{Binding ActivityKinds}" SelectedItem="{Binding NewActivityKind}" ToolTip="The kind of activity to add" />
                  <ComboBox Width="220" Margin="4,0" IsEditable="True" ItemsSource="{Binding ActivityCandidates}" Text="{Binding NewActivityTrain}"
                            ToolTip="The train it is with: those at this location near this time first, or type a headcode or UID" />
                  <Button Content="Add acti_vity" Command="{Binding AddActivityCommand}" />
                  <Button Content="▲" ToolTip="Move up" Command="{Binding MoveActivityUpCommand}" />
                  <Button Content="▼" ToolTip="Move down" Command="{Binding MoveActivityDownCommand}" />
                  <Button Content="Delete" Command="{Binding RemoveActivityCommand}" />
                  <Button Content="_Go to train" Command="{Binding GoToAssociatedCommand}" ToolTip="Show the train the activity is with" />
                  <TextBlock />
                </DockPanel>
                <DataGrid ItemsSource="{Binding Activities}" SelectedItem="{Binding SelectedActivity}" SelectionMode="Single" CanUserSortColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False">
                  <DataGrid.Columns>
                    <DataGridComboBoxColumn Header="Activity" SelectedItemBinding="{Binding KindName, UpdateSourceTrigger=PropertyChanged}" Width="170">
                      <DataGridComboBoxColumn.ElementStyle>
                        <Style TargetType="ComboBox">
                          <Setter Property="ItemsSource" Value="{Binding DataContext.Train.ActivityKinds, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Style>
                      </DataGridComboBoxColumn.ElementStyle>
                      <DataGridComboBoxColumn.EditingElementStyle>
                        <Style TargetType="ComboBox">
                          <Setter Property="ItemsSource" Value="{Binding DataContext.Train.ActivityKinds, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Style>
                      </DataGridComboBoxColumn.EditingElementStyle>
                    </DataGridComboBoxColumn>
                    <DataGridTextColumn Header="With" Binding="{Binding With}" Width="90" />
                    <DataGridTextColumn Header="Crew change at" Binding="{Binding CrewTime}" Width="100" />
                    <DataGridTextColumn Header="Duration (s)" Binding="{Binding Duration}" Width="90" />
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
              <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,2" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                         Text="1234 is 12:34, 1234H 12:34½, 12/34 a pass, +3 three minutes after the time before · Insert adds a point, Ctrl+Delete removes, Ctrl+D fills down · grey points were added by Stringline"
                         ToolTip="Type 1234 for 12:34, 1234H for 12:34½, 12/34 for a pass, +3 for 3 minutes after the time before. Enter moves down; Insert adds a point above, Ctrl+Delete removes points, Ctrl+D fills down. Greyed points were added by Stringline." />
              <DataGrid x:Name="TripGrid" ItemsSource="{Binding Trips}" SelectionUnit="CellOrRowHeader" SelectionMode="Extended"
                        CanUserSortColumns="False" HeadersVisibility="All" RowHeaderWidth="12"
                        PreviewKeyDown="OnTripGridKeyDown" PreparingCellForEdit="OnTripCellPreparing" CellEditEnding="OnTripCellEditEnding"
                        CurrentCellChanged="OnTripCurrentCellChanged">
                <DataGrid.RowStyle>
                  <Style TargetType="DataGridRow">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsAdded}" Value="True">
                        <Setter Property="Foreground" Value="#9E9E9E" />
                        <Setter Property="ToolTip" Value="Added by Stringline (a quick fix); edit it to keep it as yours" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="18" CellTemplate="{StaticResource IssueMark}" IsReadOnly="True" />
                  <DataGridTemplateColumn Header="Location" Width="90" SortMemberPath="Location">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate><TextBlock Text="{Binding Location}" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                      <DataTemplate>
                        <ComboBox Style="{StaticResource CodeBox}" Text="{Binding Location, UpdateSourceTrigger=Explicit}"
                                  ItemsSource="{Binding DataContext.Locations, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Arr" Binding="{Binding Arrival}" SortMemberPath="Arrival" Width="58" />
                  <DataGridTextColumn Header="Dep/pass" Binding="{Binding Departure}" SortMemberPath="Departure" Width="64" />
                  <DataGridTemplateColumn Header="Plat" Width="50" SortMemberPath="Platform">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate><TextBlock Text="{Binding Platform}" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                      <DataTemplate>
                        <ComboBox Style="{StaticResource CodeBox}" Text="{Binding Platform, UpdateSourceTrigger=Explicit}" ItemsSource="{Binding PlatformChoices}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Line" Width="50" SortMemberPath="Line">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate><TextBlock Text="{Binding Line}" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                      <DataTemplate>
                        <ComboBox Style="{StaticResource CodeBox}" Text="{Binding Line, UpdateSourceTrigger=Explicit}" ItemsSource="{Binding LineChoices}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Path" Width="50" SortMemberPath="Path">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate><TextBlock Text="{Binding Path}" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                      <DataTemplate>
                        <ComboBox Style="{StaticResource CodeBox}" Text="{Binding Path, UpdateSourceTrigger=Explicit}" ItemsSource="{Binding PathChoices}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Eng" Binding="{Binding EngAllowance}" SortMemberPath="EngAllowance" Width="40" />
                  <DataGridTextColumn Header="Pth" Binding="{Binding PathAllowance}" SortMemberPath="PathAllowance" Width="40" />
                  <DataGridTextColumn Header="Prf" Binding="{Binding PerfAllowance}" SortMemberPath="PerfAllowance" Width="40" />
                  <DataGridTextColumn Header="Dwell" Binding="{Binding Dwell}" SortMemberPath="Dwell" Width="45" />
                  <DataGridTextColumn Header="Req %" Binding="{Binding RequestPercent}" SortMemberPath="RequestPercent" Width="45" />
                  <DataGridCheckBoxColumn Header="Set down" Binding="{Binding SetDown, UpdateSourceTrigger=PropertyChanged}" SortMemberPath="SetDown" Width="58" />
                  <DataGridCheckBoxColumn Header="Thru line" Binding="{Binding ThroughLine, UpdateSourceTrigger=PropertyChanged}" SortMemberPath="ThroughLine" Width="58" />
                  <DataGridTextColumn Header="Stop loc" Binding="{Binding StopLocation}" SortMemberPath="StopLocation" Width="50" />
                  <DataGridTextColumn Header="New cat" Binding="{Binding NewCategory}" SortMemberPath="NewCategory" Width="60" />
                  <DataGridTextColumn Header="Activities" Binding="{Binding Activities}" IsReadOnly="True" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Grid>
        </TabItem>

        <!-- The header -->
        <TabItem Header="Header" DataContext="{Binding Header}">
          <Grid Margin="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="*" MaxWidth="640" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Label Content="Sim ID" />
            <TextBlock Grid.Column="1" Text="{Binding AreaId}" VerticalAlignment="Center" Margin="0,4" />
            <Label Grid.Row="1" Content="_Name" Target="{Binding ElementName=NameBox}" />
            <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Text="{Binding Name}" Margin="0,2" Padding="2"
                     ToolTip="SimSig's advice: no version in the title" />
            <Label Grid.Row="2" Content="Version" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Version}" VerticalAlignment="Center" Margin="0,4"
                       ToolTip="Save raises the build number; Draft ▸ Release version raises the minor or major number" />
            <Label Grid.Row="3" Content="_Start and finish" Target="{Binding ElementName=StartBox}" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
              <TextBox x:Name="StartBox" Width="70" Padding="2" Text="{Binding StartTime}" />
              <TextBlock Text="to" Margin="6,0" VerticalAlignment="Center" />
              <TextBox Width="70" Padding="2" Text="{Binding FinishTime}" />
            </StackPanel>
            <Label Grid.Row="4" Content="_Template" Target="{Binding ElementName=TemplateBox}" />
            <TextBox x:Name="TemplateBox" Grid.Row="4" Grid.Column="1" Text="{Binding Template}" Margin="0,2" Padding="2"
                     ToolTip="The train description template for trains whose description is $template, e.g. $originTime $originName-$destName $operator ($stock)" />
            <Label Grid.Row="5" Content="_Description" Target="{Binding ElementName=HeaderDescriptionBox}" VerticalAlignment="Top" Margin="0,4,0,0" />
            <TextBox x:Name="HeaderDescriptionBox" Grid.Row="5" Grid.RowSpan="2" Grid.Column="1" Text="{Binding Description}" Margin="0,2" Padding="2"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="160" VerticalAlignment="Stretch" />
          </Grid>
        </TabItem>

        <!-- Rules (S45) -->
        <TabItem Header="Rules" DataContext="{Binding Rules}" views:Help.Topic="{x:Static services:HelpTopics.TimetableEditorRules}">
          <DockPanel Margin="4">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
              <ComboBox Width="250" ItemsSource="{Binding Kinds}" SelectedItem="{Binding NewKind}" ToolTip="The kind of rule" />
              <Label Content="X" />
              <ComboBox Width="170" IsEditable="True" ItemsSource="{Binding TrainChoices}" Text="{Binding NewX}" ToolTip="Train X: pick, or type a headcode or UID" />
              <Label Content="Y" />
              <ComboBox Width="170" IsEditable="True" ItemsSource="{Binding TrainChoices}" Text="{Binding NewY}" ToolTip="Train Y" />
              <Label Content="Z" />
              <TextBox Width="80" Padding="2" Text="{Binding NewLocation}" ToolTip="The location, for the rules that name one" />
              <Label Content="Minutes" />
              <TextBox Width="45" Padding="2" Text="{Binding NewMinutes}" ToolTip="Minutes after Y's event; H for a half (0H, 2, 25)" />
              <Button Content="Add _rule" Margin="6,0,0,0" Command="{Binding AddCommand}" />
              <Button Content="De_lete rule" Command="{Binding RemoveCommand}" />
              <CheckBox Content="Only rules about the _selected train" VerticalAlignment="Center" Margin="12,0" IsChecked="{Binding ThisTrainOnly}" />
            </WrapPanel>
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" SelectionMode="Single" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False">
              <DataGrid.Columns>
                <DataGridTemplateColumn Width="18" CellTemplate="{StaticResource IssueMark}" IsReadOnly="True" />
                <DataGridComboBoxColumn Header="Rule" SelectedItemBinding="{Binding Kind, UpdateSourceTrigger=PropertyChanged}" Width="260">
                  <DataGridComboBoxColumn.ElementStyle>
                    <Style TargetType="ComboBox">
                      <Setter Property="ItemsSource" Value="{Binding DataContext.Rules.Kinds, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Style>
                  </DataGridComboBoxColumn.ElementStyle>
                  <DataGridComboBoxColumn.EditingElementStyle>
                    <Style TargetType="ComboBox">
                      <Setter Property="ItemsSource" Value="{Binding DataContext.Rules.Kinds, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Style>
                  </DataGridComboBoxColumn.EditingElementStyle>
                </DataGridComboBoxColumn>
                <DataGridTextColumn Header="X" Binding="{Binding X}" Width="80" />
                <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="80" />
                <DataGridTextColumn Header="Z" Binding="{Binding Location}" Width="80" />
                <DataGridTextColumn Header="Minutes" Binding="{Binding Minutes}" Width="65" />
                <DataGridTextColumn Header="Issues" Binding="{Binding IssueTip, Mode=OneWay}" IsReadOnly="True" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>

        <!-- Seed groups (S45) -->
        <TabItem Header="Seed groups" DataContext="{Binding SeedGroups}" views:Help.Topic="{x:Static services:HelpTopics.TimetableEditorSeedGroups}">
          <DockPanel Margin="4">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
              <Button Content="_New seed group…" Command="{Binding AddCommand}" />
              <Button Content="De_lete seed group" Command="{Binding RemoveCommand}" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding AtStart}" TextWrapping="Wrap" Margin="0,6,0,0" />
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" SelectionMode="Single" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="180" />
                <DataGridTextColumn Header="Start" Binding="{Binding Start}" Width="60" />
                <DataGridTextColumn Header="Trains" Binding="{Binding Trains, Mode=OneWay}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="Sharing a seed point" Binding="{Binding Clashes, Mode=OneWay}" IsReadOnly="True" Width="200" />
                <DataGridTextColumn Header="ID" Binding="{Binding Id, Mode=OneWay}" IsReadOnly="True" Width="120" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>

        <!-- Categories (S45) -->
        <TabItem Header="Categories" DataContext="{Binding Categories}" views:Help.Topic="{x:Static services:HelpTopics.TimetableEditorCategories}">
          <DockPanel Margin="4">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
              <Button Content="_New category…" Command="{Binding AddCommand}" ToolTip="A copy of the selected category, or SimSig's usual values" />
              <Button Content="De_lete category…" Command="{Binding RemoveCommand}" ToolTip="Its trains move to another category first" />
            </StackPanel>
            <Border DockPanel.Dock="Bottom" DataContext="{Binding Selected}" Visibility="{Binding Converter={StaticResource NotNull}}" Margin="0,6,0,0">
              <StackPanel>
                <TextBlock Text="Dwell times (seconds)" FontWeight="SemiBold" />
                <WrapPanel>
                  <Label Content="Red signal move off" /><TextBox Width="45" Padding="2" Text="{Binding [RedSignalMoveOff]}" />
                  <Label Content="Station forward" /><TextBox Width="45" Padding="2" Text="{Binding [StationForward]}" />
                  <Label Content="Station reverse" /><TextBox Width="45" Padding="2" Text="{Binding [StationReverse]}" />
                  <Label Content="Terminate forward" /><TextBox Width="45" Padding="2" Text="{Binding [TerminateForward]}" />
                  <Label Content="Terminate reverse" /><TextBox Width="45" Padding="2" Text="{Binding [TerminateReverse]}" />
                  <Label Content="Join" /><TextBox Width="45" Padding="2" Text="{Binding [Join]}" />
                  <Label Content="Divide" /><TextBox Width="45" Padding="2" Text="{Binding [Divide]}" />
                  <Label Content="Crew change" /><TextBox Width="45" Padding="2" Text="{Binding [CrewChange]}" />
                </WrapPanel>
                <TextBlock Text="Speed classes (each sim names its own; numbered here)" FontWeight="SemiBold" Margin="0,6,0,0" />
                <ItemsControl ItemsSource="{Binding Bits}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="16" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate><CheckBox Content="{Binding Bit}" IsChecked="{Binding IsSet}" Margin="0,2" /></DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" SelectionMode="Single" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                <DataGridCheckBoxColumn Header="Freight" Binding="{Binding IsFreight, UpdateSourceTrigger=PropertyChanged}" Width="55" />
                <DataGridCheckBoxColumn Header="Goods lines" Binding="{Binding CanUseGoodsLines, UpdateSourceTrigger=PropertyChanged}" Width="75" />
                <DataGridTextColumn Header="Max speed" Binding="{Binding MaxSpeed}" Width="70" />
                <DataGridTextColumn Header="Length" Binding="{Binding TrainLength}" Width="55" />
                <DataGridTextColumn Header="Accel/brake" Binding="{Binding AccelBrake}" Width="75" />
                <DataGridTextColumn Header="Power/weight" Binding="{Binding PowerToWeight}" Width="85" />
                <DataGridTextColumn Header="Electrification" Binding="{Binding Electrification}" Width="95" />
                <DataGridTextColumn Header="Caution set" Binding="{Binding CautionSpeedSet}" Width="80" />
                <DataGridTextColumn Header="Speed classes" Binding="{Binding SpeedClassText, Mode=OneWay}" IsReadOnly="True" Width="90" />
                <DataGridTextColumn Header="Trains" Binding="{Binding UsedBy, Mode=OneWay}" IsReadOnly="True" Width="50" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>

        <!-- Decisions, Class of Service, scenario options and Driving (S45) -->
        <TabItem Header="Lists" DataContext="{Binding Lists}" views:Help.Topic="{x:Static services:HelpTopics.TimetableEditorLists}">
          <TabControl Margin="4">
            <TabItem Header="Decisions">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                  <Button Content="New decision" Command="{Binding AddDecisionCommand}" />
                  <Button Content="Delete decision" Command="{Binding RemoveDecisionCommand}" />
                </StackPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Decisions}" SelectedItem="{Binding SelectedDecision}" SelectionMode="Single" CanUserAddRows="False" AutoGenerateColumns="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding [@ID]}" Width="90" />
                    <DataGridTextColumn Header="Description" Binding="{Binding [Description]}" Width="*" />
                    <DataGridTextColumn Header="Chosen" Binding="{Binding [Chosen]}" Width="60" />
                  </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,4">
                  <TextBlock Text="Choices" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <Button Content="New choice" Command="{Binding AddChoiceCommand}" />
                  <Button Content="Delete choice" Command="{Binding RemoveChoiceCommand}" />
                </StackPanel>
                <DataGrid Grid.Row="3" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" SelectionMode="Single" CanUserAddRows="False" AutoGenerateColumns="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding [@ID]}" Width="90" />
                    <DataGridTextColumn Header="Announcement" Binding="{Binding [Announcement]}" Width="*" />
                    <DataGridTextColumn Header="Weight" Binding="{Binding [Weight]}" Width="60" />
                    <DataGridTextColumn Header="Chosen" Binding="{Binding [Chosen]}" Width="60" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </TabItem>
            <TabItem Header="Class of Service">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                  <Button Content="New rule" Command="{Binding AddClassOfServiceCommand}" />
                  <Button Content="Delete rule" Command="{Binding RemoveClassOfServiceCommand}" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding ClassOfService}" SelectedItem="{Binding SelectedClassOfService}" SelectionMode="Single" CanUserAddRows="False" AutoGenerateColumns="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Class of service" Binding="{Binding [ClassOfService]}" Width="110" />
                    <DataGridTextColumn Header="Headcode match" Binding="{Binding [IDmatch]}" Width="*" />
                    <DataGridTextColumn Header="Freight" Binding="{Binding [Freight]}" Width="60" />
                    <DataGridTextColumn Header="Speed class match" Binding="{Binding [SpeedClassMatchType]}" Width="120" />
                    <DataGridTextColumn Header="Speed class" Binding="{Binding [MatchSpeedClass]}" Width="90" />
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </TabItem>
            <TabItem Header="Scenario options">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                  <Button Content="New option" Command="{Binding AddScenarioOptionCommand}" />
                  <Button Content="Delete option" Command="{Binding RemoveScenarioOptionCommand}" CommandParameter="{Binding SelectedItem, ElementName=ScenarioGrid}" />
                </StackPanel>
                <DataGrid x:Name="ScenarioGrid" ItemsSource="{Binding Scenario}" SelectionMode="Single" CanUserAddRows="False" AutoGenerateColumns="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Option" Binding="{Binding Option}" Width="160" />
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="80" />
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </TabItem>
            <TabItem Header="Driving">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="2*" />
                </Grid.RowDefinitions>
                <DataGrid ItemsSource="{Binding CautionSets}" SelectedItem="{Binding SelectedCautionSet}" SelectionMode="Single" CanUserAddRows="False" AutoGenerateColumns="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Caution speed set" Binding="{Binding [Name]}" Width="*" />
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="1" Text="Caution speeds of the selected set" FontWeight="SemiBold" Margin="0,6,0,4" />
                <DataGrid Grid.Row="2" ItemsSource="{Binding CautionSpeeds}" CanUserAddRows="False" AutoGenerateColumns="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Aspect passed" Binding="{Binding [AspectPassed]}" Width="*" />
                    <DataGridTextColumn Header="From line speed" Binding="{Binding [FromLineSpeed]}" Width="*" />
                    <DataGridTextColumn Header="To line speed" Binding="{Binding [ToLineSpeed]}" Width="*" />
                    <DataGridTextColumn Header="Reduce now" Binding="{Binding [ReduceNowValue]}" Width="*" />
                    <DataGridTextColumn Header="Approach next" Binding="{Binding [ApproachNextValue]}" Width="*" />
                    <DataGridTextColumn Header="Next distance" Binding="{Binding [ApproachNextDistance]}" Width="*" />
                    <DataGridTextColumn Header="Now type" Binding="{Binding [NowValueType]}" Width="*" />
                    <DataGridTextColumn Header="Next type" Binding="{Binding [NextValueType]}" Width="*" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </TabItem>
          </TabControl>
        </TabItem>
      </TabControl>

      <GridSplitter Grid.Row="1" Grid.Column="2" Height="6" HorizontalAlignment="Stretch" />

      <!-- The draft board (S44): the draft's graph, its selection the grid's -->
      <DockPanel Grid.Row="2" Grid.Column="2" x:Name="BoardPanel" views:Help.Topic="{x:Static services:HelpTopics.TimetableEditorBoard}">
        <Border DockPanel.Dock="Bottom" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="4,2">
          <StackPanel>
            <TextBlock Text="{Binding Board.Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Board.Status}" />
            <TextBlock Text="{Binding Board.EditStatus}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Board.EditStatus}" Visibility="{Binding Board.EditStatus, Converter={StaticResource NotNull}}" />
          </StackPanel>
        </Border>
        <controls:BoardView x:Name="DraftBoard" DataContext="{Binding Board.Board}" />
      </DockPanel>

      <GridSplitter Grid.Row="3" Grid.Column="2" Height="6" HorizontalAlignment="Stretch" />

      <!-- Issues -->
      <DockPanel Grid.Row="4" Grid.Column="2" x:Name="IssuesPanel" views:Help.Topic="{x:Static services:HelpTopics.TimetableEditorIssues}">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
          <Label Content="Iss_ues" Target="{Binding ElementName=IssueFilterBox}" FontWeight="SemiBold" />
          <ComboBox DockPanel.Dock="Right" Width="90" ItemsSource="{Binding IssueLevels}" SelectedItem="{Binding IssueLevel}"
                    ToolTip="All, Warnings and Errors, or Errors only" />
          <Button DockPanel.Dock="Right" Content="Fix all of this _kind" Command="{Binding ApplyFixesOfKindCommand}" />
          <Button DockPanel.Dock="Right" Content="_Apply fix" Command="{Binding ApplyFixCommand}" ToolTip="{Binding SelectedIssue.Fix}" />
          <TextBox x:Name="IssueFilterBox" Margin="4,0,8,0" Padding="2" Text="{Binding IssueFilter, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Filter by message, train, location or check" />
        </DockPanel>
        <DataGrid x:Name="IssuesGrid" ItemsSource="{Binding Issues}" SelectedItem="{Binding SelectedIssue}" SelectionMode="Single" IsReadOnly="True"
                  CanUserSortColumns="True">
          <DataGrid.Columns>
            <DataGridTemplateColumn Width="18" SortMemberPath="Severity">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="●" HorizontalAlignment="Center" Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" ToolTip="{Binding Severity}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Train" Binding="{Binding Train}" Width="60" />
            <DataGridTextColumn Header="At" Binding="{Binding Where}" Width="70" />
            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*">
              <DataGridTextColumn.CellStyle>
                <Style TargetType="DataGridCell">
                  <Setter Property="ToolTip" Value="{Binding Hint}" />
                </Style>
              </DataGridTextColumn.CellStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Quick fix" Binding="{Binding Fix}" Width="180" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
