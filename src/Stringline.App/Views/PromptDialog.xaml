<Window x:Class="Stringline.App.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Stringline.App.Views"
        Title="{Binding Title}" SizeToContent="Height" Width="400" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <views:NotNullToVisibilityConverter x:Key="NotNull" />
  </Window.Resources>
  <StackPanel Margin="14">
    <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#E65100"
               Visibility="{Binding Note, Converter={StaticResource NotNull}}" />
    <ItemsControl x:Name="FieldList" ItemsSource="{Binding Fields}" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="{Binding Label}" Padding="0" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Padding="2"
                     Visibility="{Binding HasOptions, Converter={StaticResource NotNull}, ConverterParameter=invert}" />
            <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding Options}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                      IsTextSearchEnabled="True" Visibility="{Binding HasOptions, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Hint}" Foreground="#757575" FontSize="11" TextWrapping="Wrap"
                       Visibility="{Binding Hint, Converter={StaticResource NotNull}}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{Binding Error}" Foreground="#C62828" TextWrapping="Wrap" Margin="0,6,0,0"
               Visibility="{Binding Error, Converter={StaticResource NotNull}}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="{Binding AcceptText}" IsDefault="True" MinWidth="80" Padding="8,0" Margin="0,0,6,0" Click="OnOk" />
      <Button Content="Cancel" IsCancel="True" Width="80" />
    </StackPanel>
  </StackPanel>
</Window>
