<Window x:Class="Stringline.App.Views.ConnectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Stringline.App.Views"
        xmlns:services="clr-namespace:Stringline.App.Services"
        views:Help.Topic="{x:Static services:HelpTopics.Connect}"
        Title="Connect to SimSig" SizeToContent="Height" Width="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FocusManager.FocusedElement="{Binding ElementName=HostBox}">
  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.Resources>
      <Style TargetType="Label">
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style TargetType="TextBox">
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="Padding" Value="2" />
      </Style>
    </Grid.Resources>

    <TextBlock Grid.ColumnSpan="3" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10"
               Text="Enable the Interface Gateway in SimSig before connecting. Payware sims need your SimSig forum login." />

    <Label Grid.Row="1" Content="_Host" Target="{Binding ElementName=HostBox}" />
    <TextBox Grid.Row="1" Grid.Column="1" x:Name="HostBox" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />

    <Label Grid.Row="2" Content="_Port" Target="{Binding ElementName=PortBox}" />
    <TextBox Grid.Row="2" Grid.Column="1" x:Name="PortBox" Width="90" HorizontalAlignment="Left" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />

    <Label Grid.Row="3" Content="_Username" Target="{Binding ElementName=UserBox}" />
    <TextBox Grid.Row="3" Grid.Column="1" x:Name="UserBox" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Leave empty for free sims" />

    <Label Grid.Row="4" Content="Pass_word" Target="{Binding ElementName=PasswordBox}" />
    <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="PasswordBox" Margin="0,3" Padding="2" PasswordChanged="OnPasswordChanged" />

    <!-- S30 (#14): how the password is kept, Forget, and the privacy policy -->
    <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4">
      <CheckBox x:Name="RememberBox" IsChecked="{Binding RememberPassword}"
                ToolTip="Saved in settings.json in %APPDATA%\Stringline, encrypted with Windows (DPAPI) so that only your Windows account on this PC can read it. Untick this and connect, or press Forget saved password, to remove it.">
        <TextBlock Text="Remember the password (encrypted for your Windows account)" TextWrapping="Wrap" />
      </CheckBox>
      <StackPanel Orientation="Horizontal" Margin="18,4,0,0">
        <Button x:Name="ForgetButton" Content="_Forget saved password" Padding="8,1" Command="{Binding ForgetPasswordCommand}"
                ToolTip="Remove the saved password from this PC now, even if you then cancel." />
        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
          <Hyperlink x:Name="PrivacyLink" Command="ApplicationCommands.Help" CommandParameter="{x:Static services:HelpTopics.Privacy}">Privacy</Hyperlink>
        </TextBlock>
      </StackPanel>
    </StackPanel>
    <CheckBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" IsChecked="{Binding SubscribeTd}">
      <TextBlock Text="Also subscribe to train describer and signalling messages" TextWrapping="Wrap" />
    </CheckBox>

    <Label Grid.Row="7" Content="_Timetable" Target="{Binding ElementName=TimetableBox}" />
    <TextBox Grid.Row="7" Grid.Column="1" x:Name="TimetableBox" Text="{Binding TimetablePath, UpdateSourceTrigger=PropertyChanged}"
             ToolTip="Optional: the sim's .wtt. Leave empty to choose one once the sim is known." />
    <Button Grid.Row="7" Grid.Column="2" Content="Browse…" Margin="6,3,0,3" Padding="8,0" Command="{Binding BrowseTimetableCommand}" />

    <DockPanel Grid.Row="8" Grid.ColumnSpan="3" Margin="0,14,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Connect" IsDefault="True" Width="84" Margin="0,0,6,0" Click="OnOk" />
        <Button Content="Cancel" IsCancel="True" Width="84" />
      </StackPanel>
      <TextBlock Text="{Binding Error}" Foreground="#C62828" TextWrapping="Wrap" VerticalAlignment="Center" />
    </DockPanel>
  </Grid>
</Window>
