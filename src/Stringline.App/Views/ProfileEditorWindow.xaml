<Window x:Class="Stringline.App.Views.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Stringline.App.Controls"
        xmlns:views="clr-namespace:Stringline.App.Views"
        Title="{Binding Title}" Height="720" Width="1040" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <views:NotNullToVisibilityConverter x:Key="NotNull" />
    <views:ColourTextBrushConverter x:Key="ColourBrush" />
    <Style TargetType="Button">
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="CanUserSortColumns" Value="False" />
      <Setter Property="CanUserReorderColumns" Value="False" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0" />
      <Setter Property="RowHeaderWidth" Value="0" />
    </Style>
    <Style TargetType="TextBlock" x:Key="Hint">
      <Setter Property="Foreground" Value="#757575" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,2,0,6" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="10">
    <!-- Buttons and messages -->
    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding Error}" Foreground="#C62828" TextWrapping="Wrap"
                   Visibility="{Binding Error, Converter={StaticResource NotNull}}" />
        <TextBlock Text="{Binding Status}" Foreground="#2E7D32" TextWrapping="Wrap"
                   Visibility="{Binding Status, Converter={StaticResource NotNull}}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="OK" IsDefault="True" Width="80" Command="{Binding OkCommand}" />
        <Button Content="Cancel" IsCancel="True" Width="80" Command="{Binding CancelCommand}" />
        <Button Content="_Apply" Width="80" Margin="0" Command="{Binding ApplyCommand}" />
      </StackPanel>
    </Grid>

    <TabControl>
      <!-- General -->
      <TabItem Header="General">
        <DockPanel Margin="8">
          <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="320" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="_Sim ID" Target="{Binding ElementName=SimIdBox}" Padding="0" VerticalAlignment="Center" />
            <TextBox x:Name="SimIdBox" Grid.Column="1" Text="{Binding SimId, UpdateSourceTrigger=PropertyChanged}" Padding="2" Margin="0,2"
                     IsReadOnly="{Binding NeedsSimId, Converter={x:Static views:InverseBooleanConverter.Instance}}" />
            <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Hint}"
                       Text="This timetable has no sim ID. Name the sim (e.g. its SimSig area ID) so its profile can be saved and found again."
                       Visibility="{Binding NeedsSimId, Converter={StaticResource BoolToVisibility}}" />
            <Label Grid.Row="1" Content="Sim _name" Target="{Binding ElementName=SimNameBox}" Padding="0" VerticalAlignment="Center" />
            <TextBox x:Name="SimNameBox" Grid.Row="1" Grid.Column="1" Text="{Binding SimName}" Padding="2" Margin="0,2" />
            <TextBlock Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Hint}" Text="Shown in the title bar and on exports." />
          </Grid>
          <DockPanel DockPanel.Dock="Top" Margin="0,12,0,4">
            <Button DockPanel.Dock="Right" Content="_Import names from CSV…" Margin="0" VerticalAlignment="Center" Command="{Binding ImportNamesCommand}" />
            <StackPanel>
              <TextBlock Text="Location names" FontWeight="SemiBold" />
              <TextBlock Style="{StaticResource Hint}" Text="Names shown on the graph instead of TIPLOCs. Leave a name blank to show the TIPLOC. A CSV has TIPLOC,name on each row." />
            </StackPanel>
          </DockPanel>
          <DataGrid ItemsSource="{Binding LocationNames}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="TIPLOC" Binding="{Binding Code, Mode=OneWay}" IsReadOnly="True" Width="110" />
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="260" />
              <DataGridTextColumn Header="On corridors" Binding="{Binding Corridors, Mode=OneWay}" IsReadOnly="True" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- Corridors -->
      <TabItem Header="Corridors">
        <Grid Margin="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Corridor list -->
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Corridors (in tab order)" FontWeight="SemiBold" Margin="0,0,0,4" />
            <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
              <WrapPanel>
                <Button Content="▲" ToolTip="Move the tab left" Command="{Binding MoveCorridorUpCommand}" />
                <Button Content="▼" ToolTip="Move the tab right" Command="{Binding MoveCorridorDownCommand}" />
                <Button Content="_New…" Command="{Binding NewCorridorCommand}" />
                <Button Content="_Remove" Command="{Binding RemoveCorridorCommand}" />
              </WrapPanel>
              <TextBlock Text="Generated corridors not in the profile" Margin="0,10,0,2" />
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="A_dd" Margin="6,0,0,0" Command="{Binding AddCandidateCommand}" />
                <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}" />
              </DockPanel>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Corridors}" SelectedItem="{Binding SelectedCorridor}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="ID" Binding="{Binding Id, Mode=OneWay}" IsReadOnly="True" Width="Auto" />
              </DataGrid.Columns>
              <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Summary}" Foreground="#757575" Margin="4,0,4,2" />
                </DataTemplate>
              </DataGrid.RowDetailsTemplate>
            </DataGrid>
          </DockPanel>

          <!-- Selected corridor -->
          <DockPanel Grid.Column="2" IsEnabled="{Binding SelectedCorridor, Converter={x:Static views:NotNullToBooleanConverter.Instance}}">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="Axis preview (Up end on the left)" FontWeight="SemiBold" />
              <Border BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,4,0,6" Background="#FCFCFA">
                <controls:AxisPreview Marks="{Binding AxisMarks}" />
              </Border>
              <CheckBox Content="Space by _distance (km) instead of by run time" IsChecked="{Binding UseDistances}" Margin="0,0,0,2" />
              <TextBlock Style="{StaticResource Hint}" Text="Distances can be from any fixed point and may count either way; missing ones are filled in by run time. With fewer than two, run time is used." />
            </StackPanel>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="▲" ToolTip="Move towards the Up end" Command="{Binding MoveLocationUpCommand}" />
                    <Button Content="▼" ToolTip="Move away from the Up end" Command="{Binding MoveLocationDownCommand}" />
                    <Button Content="Add _location…" Command="{Binding AddLocationCommand}" />
                    <Button Content="Re_move location" Margin="0" Command="{Binding RemoveLocationCommand}" />
                  </StackPanel>
                  <TextBlock Text="Locations" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <DataGrid ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="TIPLOC" Binding="{Binding Code, Mode=OneWay}" IsReadOnly="True" Width="100" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Distance (km)" Binding="{Binding Distance}" Width="100" />
                    <DataGridTextColumn Header="Platforms" Binding="{Binding Platforms}" Width="75" />
                    <DataGridTextColumn Header="Axis" Binding="{Binding Position, Mode=OneWay}" IsReadOnly="True" Width="55" />
                    <DataGridCheckBoxColumn Header="Timing point only" Binding="{Binding IsTimingPointOnly, Mode=OneWay}" IsReadOnly="True" Width="Auto" />
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
              <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent" />
              <DockPanel Grid.Row="2">
                <StackPanel DockPanel.Dock="Top" Margin="0,4,0,4">
                  <TextBlock Text="Sections" FontWeight="SemiBold" />
                  <TextBlock Style="{StaticResource Hint}" Text="Pick a layout, or type tracks as Name:Direction, e.g. Up Fast:Up, Up Slow:Up, Down:Down, Relief:Bi. Headway as m:ss." />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Sections}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Section" Binding="{Binding Label, Mode=OneWay}" IsReadOnly="True" Width="*" />
                    <DataGridComboBoxColumn Header="Layout" SelectedItemBinding="{Binding Layout}" Width="170">
                      <DataGridComboBoxColumn.ElementStyle>
                        <Style TargetType="ComboBox">
                          <Setter Property="ItemsSource" Value="{Binding DataContext.LayoutNames, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Style>
                      </DataGridComboBoxColumn.ElementStyle>
                      <DataGridComboBoxColumn.EditingElementStyle>
                        <Style TargetType="ComboBox">
                          <Setter Property="ItemsSource" Value="{Binding DataContext.LayoutNames, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Style>
                      </DataGridComboBoxColumn.EditingElementStyle>
                    </DataGridComboBoxColumn>
                    <DataGridTextColumn Header="Tracks" Binding="{Binding Tracks}" Width="1.4*" />
                    <DataGridTextColumn Header="Headway" Binding="{Binding Headway}" Width="70" />
                    <DataGridTextColumn Header="Min run (WTT)" Binding="{Binding MinRun, Mode=OneWay}" IsReadOnly="True" Width="110" />
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Grid>
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- Categories -->
      <TabItem Header="Categories">
        <DockPanel Margin="8">
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                     Text="How each WTT category is drawn, and how much its trains matter when regulating (priority 0–100, higher first). Colours are #RRGGBB. Dashed and dotted styles apply to the WTT, plan and actual lines; forecasts keep their own dashes." />
          <DataGrid ItemsSource="{Binding Categories}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="ID" Binding="{Binding Id, Mode=OneWay}" IsReadOnly="True" Width="70" />
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
              <DataGridTemplateColumn Header="" Width="34" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Width="22" Height="12" BorderBrush="#9E9E9E" BorderThickness="1" Background="{Binding Colour, Converter={StaticResource ColourBrush}}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Colour" Binding="{Binding Colour}" Width="90" />
              <DataGridComboBoxColumn Header="Line" SelectedItemBinding="{Binding Style}" Width="90">
                <DataGridComboBoxColumn.ElementStyle>
                  <Style TargetType="ComboBox">
                    <Setter Property="ItemsSource" Value="{Binding DataContext.LineStyles, RelativeSource={RelativeSource AncestorType=Window}}" />
                  </Style>
                </DataGridComboBoxColumn.ElementStyle>
                <DataGridComboBoxColumn.EditingElementStyle>
                  <Style TargetType="ComboBox">
                    <Setter Property="ItemsSource" Value="{Binding DataContext.LineStyles, RelativeSource={RelativeSource AncestorType=Window}}" />
                  </Style>
                </DataGridComboBoxColumn.EditingElementStyle>
              </DataGridComboBoxColumn>
              <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="70" />
              <DataGridTextColumn Header="Trains" Binding="{Binding Trains, Mode=OneWay}" IsReadOnly="True" Width="60" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
