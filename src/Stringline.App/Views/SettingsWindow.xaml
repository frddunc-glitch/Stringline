<Window x:Class="Stringline.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Stringline.App.Views"
        Title="Settings" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True">
  <Window.Resources>
    <views:NotNullToVisibilityConverter x:Key="NotNull" />
    <Style TargetType="Button">
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="Label">
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style TargetType="TextBlock" x:Key="Hint">
      <Setter Property="Foreground" Value="#757575" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="0,1,0,6" />
    </Style>
    <Style TargetType="TextBlock" x:Key="Intro">
      <Setter Property="Foreground" Value="#616161" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="12">
    <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Content="_Restore defaults" Command="{Binding RestoreDefaultsCommand}" VerticalAlignment="Top" />
      <TextBlock Grid.Column="1" Text="{Binding Error}" Foreground="#C62828" TextWrapping="Wrap" Margin="6,0" VerticalAlignment="Center"
                 Visibility="{Binding Error, Converter={StaticResource NotNull}}" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
        <Button Content="OK" IsDefault="True" Width="80" Click="OnOk" />
        <Button Content="Cancel" IsCancel="True" Width="80" Margin="0" />
      </StackPanel>
    </Grid>

    <TabControl>
      <!-- Forecast and conflicts -->
      <TabItem Header="Forecast and conflicts">
        <StackPanel Margin="10">
          <TextBlock Style="{StaticResource Intro}"
                     Text="How trains are forecast and which clashes are shown. Durations are m:ss, minutes (2.5) or seconds (90s)." />
          <CheckBox Content="Forecast _knock-on delay from other trains (headways and single lines)" IsChecked="{Binding ForecastKnockOn}" />
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="230" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="Default _dwell" Target="{Binding ElementName=Dwell}" />
            <TextBox x:Name="Dwell" Grid.Column="1" Text="{Binding DefaultDwell, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2" Style="{StaticResource Hint}" Margin="8,0,0,0" VerticalAlignment="Center"
                       Text="at a stop the WTT gives no dwell for (0:30)" />
            <Label Grid.Row="1" Content="Default _turnaround" Target="{Binding ElementName=Turnaround}" />
            <TextBox x:Name="Turnaround" Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding DefaultTurnaround, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Hint}" Margin="8,0,0,0" VerticalAlignment="Center"
                       Text="from arriving to forming the next working (0:30)" />
            <Label Grid.Row="2" Content="Train may have _stopped after" Target="{Binding ElementName=Stopped}" />
            <TextBox x:Name="Stopped" Grid.Row="2" Grid.Column="1" Text="{Binding PossiblyStopped, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Hint}" Margin="8,0,0,0" VerticalAlignment="Center"
                       Text="without a report past its forecast (5:00)" />
            <Label Grid.Row="3" Content="_Platform margin" Target="{Binding ElementName=MarginBox}" />
            <TextBox x:Name="MarginBox" Grid.Row="3" Grid.Column="1" Margin="0,4" Text="{Binding PlatformMargin, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Hint}" Margin="8,0,0,0" VerticalAlignment="Center"
                       Text="between one train leaving a platform and the next arriving (1:00)" />
            <Label Grid.Row="4" Content="_Least conflict shown" Target="{Binding ElementName=Least}" />
            <TextBox x:Name="Least" Grid.Row="4" Grid.Column="1" Text="{Binding MinConflict, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Hint}" Margin="8,0,0,0" VerticalAlignment="Center"
                       Text="smaller clashes are booking rounding (0:30)" />
          </Grid>
        </StackPanel>
      </TabItem>

      <!-- Suggestions -->
      <TabItem Header="Suggestions">
        <StackPanel Margin="10">
          <TextBlock Style="{StaticResource Intro}"
                     Text="What each kind of re-plan costs when suggestions are ranked, in minutes of weighted delay. A higher penalty makes that kind of suggestion rarer." />
          <CheckBox Content="Suggest _terminating short or cancelling a train for a block" IsChecked="{Binding AllowCancellation}" />
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="230" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="_Platform change" Target="{Binding ElementName=PlatformPenalty}" />
            <TextBox x:Name="PlatformPenalty" Grid.Column="1" Text="{Binding PlatformChangePenalty, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2" Style="{StaticResource Hint}" Margin="8,0,0,0" VerticalAlignment="Center" Text="min (2)" />
            <Label Grid.Row="1" Content="_Line change" Target="{Binding ElementName=LinePenalty}" />
            <TextBox x:Name="LinePenalty" Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding LineChangePenalty, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Hint}" Margin="8,0,0,0" VerticalAlignment="Center" Text="min (2)" />
            <Label Grid.Row="2" Content="Terminating _short" Target="{Binding ElementName=TerminatePenaltyBox}" />
            <TextBox x:Name="TerminatePenaltyBox" Grid.Row="2" Grid.Column="1" Text="{Binding TerminatePenalty, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Hint}" Margin="8,0,0,0" VerticalAlignment="Center" Text="min (30)" />
            <Label Grid.Row="3" Content="_Cancelling" Target="{Binding ElementName=CancelPenaltyBox}" />
            <TextBox x:Name="CancelPenaltyBox" Grid.Row="3" Grid.Column="1" Margin="0,4" Text="{Binding CancelPenalty, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Hint}" Margin="8,0,0,0" VerticalAlignment="Center" Text="min (60)" />
          </Grid>
        </StackPanel>
      </TabItem>

      <!-- Folders -->
      <TabItem Header="Folders">
        <StackPanel Margin="10">
          <TextBlock Style="{StaticResource Intro}" Text="Leave a box blank for the folder shown under it." />
          <Label Content="_Timetables (where suggestions are looked for)" Target="{Binding ElementName=Timetables}" />
          <DockPanel Margin="0,2,0,0">
            <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Command="{Binding BrowseCommand}" CommandParameter="timetables" />
            <TextBox x:Name="Timetables" Text="{Binding TimetableFolder, UpdateSourceTrigger=PropertyChanged}" />
          </DockPanel>
          <TextBlock Style="{StaticResource Hint}" Text="{Binding DefaultTimetableFolder}" />
          <Label Content="_Saved sessions" Target="{Binding ElementName=Sessions}" />
          <DockPanel Margin="0,2,0,0">
            <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Command="{Binding BrowseCommand}" CommandParameter="sessions" />
            <TextBox x:Name="Sessions" Text="{Binding SessionsFolder, UpdateSourceTrigger=PropertyChanged}" />
          </DockPanel>
          <TextBlock Style="{StaticResource Hint}" Text="{Binding Defaults.Sessions}" />
          <Label Content="_Recordings" Target="{Binding ElementName=Recordings}" />
          <DockPanel Margin="0,2,0,0">
            <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Command="{Binding BrowseCommand}" CommandParameter="recordings" />
            <TextBox x:Name="Recordings" Text="{Binding RecordingsFolder, UpdateSourceTrigger=PropertyChanged}" />
          </DockPanel>
          <TextBlock Style="{StaticResource Hint}" Text="{Binding Defaults.Recordings}" />
          <Label Content="_Exports (offered first; the last folder used is offered after that)" Target="{Binding ElementName=Exports}" />
          <DockPanel Margin="0,2,0,0">
            <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Command="{Binding BrowseCommand}" CommandParameter="exports" />
            <TextBox x:Name="Exports" Text="{Binding ExportsFolder, UpdateSourceTrigger=PropertyChanged}" />
          </DockPanel>
          <TextBlock Style="{StaticResource Hint}" Text="{Binding Defaults.Exports}" />
        </StackPanel>
      </TabItem>

      <!-- Logging and housekeeping -->
      <TabItem Header="Logging and housekeeping">
        <StackPanel Margin="10">
          <TextBlock Style="{StaticResource Intro}"
                     Text="Log files help find what went wrong. They never hold your SimSig password." />
          <CheckBox Content="_Detailed logging (Debug), for chasing a problem" IsChecked="{Binding DetailedLogging}" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Label Content="_Keep logs for" Target="{Binding ElementName=LogDays}" />
            <TextBox x:Name="LogDays" Width="50" Margin="8,0,6,0" Text="{Binding LogRetentionDays, UpdateSourceTrigger=PropertyChanged}" />
            <Label Content="days (from the next start)" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="_Open log folder" Command="{Binding OpenLogsCommand}" />
            <TextBlock Style="{StaticResource Hint}" Text="{Binding Defaults.Logs}" VerticalAlignment="Center" Margin="0" />
          </StackPanel>
          <Separator Margin="0,12" />
          <StackPanel Orientation="Horizontal">
            <CheckBox x:Name="DeleteOld" Content="Delete _saved sessions last saved more than" IsChecked="{Binding DeleteOldSessions}" VerticalAlignment="Center" />
            <TextBox Width="50" Margin="8,0,6,0" Text="{Binding DeleteSessionsAfterDays, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsChecked, ElementName=DeleteOld}" />
            <Label Content="days ago" />
          </StackPanel>
          <TextBlock Style="{StaticResource Hint}"
                     Text="Checked at start-up. The newest session is always kept, so it can still be resumed." />
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
