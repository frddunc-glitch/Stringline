<Window x:Class="Stringline.App.Views.ListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="480" Width="760" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="10">
    <TextBlock x:Name="Heading" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6" />
    <Button DockPanel.Dock="Bottom" Content="Close" Width="84" HorizontalAlignment="Right" Margin="0,8,0,0" IsCancel="True" IsDefault="True" Click="OnClose" />
    <ListBox x:Name="Lines" FontFamily="Consolas" VirtualizingPanel.IsVirtualizing="True" />
  </DockPanel>
</Window>
