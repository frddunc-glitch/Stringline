<Window x:Class="Stringline.App.Views.ColourPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Stringline.App.Views"
        Title="{Binding Title}" SizeToContent="Height" Width="350" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <views:NotNullToVisibilityConverter x:Key="NotNull" />
    <views:ColourTextBrushConverter x:Key="ColourBrush" />
    <Style TargetType="TextBlock" x:Key="Group">
      <Setter Property="Foreground" Value="#616161" />
      <Setter Property="Margin" Value="0,8,0,3" />
    </Style>
    <!-- One swatch: a flat square that picks its colour when clicked -->
    <DataTemplate x:Key="Swatch">
      <Button Width="26" Height="26" Margin="0,0,4,4" Padding="0" ToolTip="{Binding ToolTip}" Cursor="Hand"
              Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
              AutomationProperties.Name="{Binding Name}">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Edge" BorderBrush="#9E9E9E" BorderThickness="1" Background="{Binding Hex, Converter={StaticResource ColourBrush}}" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Edge" Property="BorderBrush" Value="#212121" />
                <Setter TargetName="Edge" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Edge" Property="BorderBrush" Value="#212121" />
                <Setter TargetName="Edge" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>
    </DataTemplate>
    <ItemsPanelTemplate x:Key="Wrap">
      <WrapPanel />
    </ItemsPanelTemplate>
  </Window.Resources>
  <StackPanel Margin="14">
    <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />

    <TextBlock Style="{StaticResource Group}" Text="Headcode class colours" />
    <ItemsControl ItemsSource="{Binding ClassColours}" ItemTemplate="{StaticResource Swatch}" ItemsPanel="{StaticResource Wrap}" Focusable="False" />

    <TextBlock Style="{StaticResource Group}" Text="Palette" />
    <ItemsControl ItemsSource="{Binding Palette}" ItemTemplate="{StaticResource Swatch}" ItemsPanel="{StaticResource Wrap}" Focusable="False" />

    <StackPanel Visibility="{Binding HasInUse, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Style="{StaticResource Group}" Text="Used by other categories" />
      <ItemsControl ItemsSource="{Binding InUse}" ItemTemplate="{StaticResource Swatch}" ItemsPanel="{StaticResource Wrap}" Focusable="False" />
    </StackPanel>

    <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="50" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="36" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Label Content="_Red" Target="{Binding ElementName=RedSlider}" Padding="0" VerticalAlignment="Center" />
      <Slider x:Name="RedSlider" Grid.Column="1" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16" IsSnapToTickEnabled="True" TickFrequency="1"
              Value="{Binding Red}" VerticalAlignment="Center" Margin="0,2" />
      <TextBlock Grid.Column="2" Text="{Binding Red}" TextAlignment="Right" VerticalAlignment="Center" />
      <Label Grid.Row="1" Content="_Green" Target="{Binding ElementName=GreenSlider}" Padding="0" VerticalAlignment="Center" />
      <Slider x:Name="GreenSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16" IsSnapToTickEnabled="True" TickFrequency="1"
              Value="{Binding Green}" VerticalAlignment="Center" Margin="0,2" />
      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Green}" TextAlignment="Right" VerticalAlignment="Center" />
      <Label Grid.Row="2" Content="_Blue" Target="{Binding ElementName=BlueSlider}" Padding="0" VerticalAlignment="Center" />
      <Slider x:Name="BlueSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16" IsSnapToTickEnabled="True" TickFrequency="1"
              Value="{Binding Blue}" VerticalAlignment="Center" Margin="0,2" />
      <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Blue}" TextAlignment="Right" VerticalAlignment="Center" />
      <Label Grid.Row="3" Content="_Code" Target="{Binding ElementName=HexBox}" Padding="0" VerticalAlignment="Center" />
      <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
        <TextBox x:Name="HexBox" Width="90" Padding="2" Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" ToolTip="#RRGGBB, e.g. #D32F2F" />
        <Button Content="Rese_t" Padding="8,0" Margin="8,0,0,0" Command="{Binding ResetCommand}" ToolTip="Back to the colour it had" />
      </StackPanel>
    </Grid>

    <!-- Was and now, side by side, with a line drawn in the new colour as the graph would -->
    <Grid Margin="0,10,0,0" Height="34">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>
      <Border BorderBrush="#9E9E9E" BorderThickness="1,1,0,1" Background="{Binding OriginalHex, Converter={StaticResource ColourBrush}}" ToolTip="{Binding OriginalHex}">
        <TextBlock Text="Was" FontSize="10" Margin="3,1" Foreground="White" />
      </Border>
      <Border Grid.Column="1" BorderBrush="#9E9E9E" BorderThickness="1" Background="{Binding ColourHex, Converter={StaticResource ColourBrush}}" ToolTip="{Binding ColourHex}">
        <TextBlock Text="Now" FontSize="10" Margin="3,1" Foreground="White" />
      </Border>
      <Border Grid.Column="2" Margin="8,0,0,0" BorderBrush="#E0E0E0" BorderThickness="1" Background="White">
        <Line X1="6" Y1="26" X2="150" Y2="6" StrokeThickness="2" Stroke="{Binding ColourHex, Converter={StaticResource ColourBrush}}" />
      </Border>
    </Grid>

    <TextBlock Text="{Binding Error}" Foreground="#C62828" TextWrapping="Wrap" Margin="0,6,0,0"
               Visibility="{Binding Error, Converter={StaticResource NotNull}}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="OK" IsDefault="True" Width="80" Margin="0,0,6,0" Click="OnOk" />
      <Button Content="Cancel" IsCancel="True" Width="80" />
    </StackPanel>
  </StackPanel>
</Window>
