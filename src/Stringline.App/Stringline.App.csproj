<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- SkiaSharp.Views.WPF 4.x ships only a windows10.0.19041 build (Windows 10 2004 or later). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Lets Linux tooling (e.g. GitHub's NuGet dependency submission) restore the full solution. No effect on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Stringline.App</RootNamespace>
    <AssemblyName>Stringline</AssemblyName>
    <!-- WPF needs culture data (XmlLanguage); the libraries stay invariant. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationIcon>Assets\stringline.ico</ApplicationIcon>
    <Description>A live electronic train graph for SimSig</Description>
  </PropertyGroup>

  <!-- Single-file, self-contained publish (S18): build/publish.ps1 passes -r win-x64 -p:PublishSingleFile=true. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <!-- WPF, SkiaSharp and SQLite native libraries go inside the exe and are unpacked on first run. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\stringline.ico" />
    <!-- The GPL's text, for the About window's View licence (embedded, so a single-file build has it). -->
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="Stringline.LICENSE.txt" Link="LICENSE" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Stringline.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stringline.Core\Stringline.Core.csproj" />
    <ProjectReference Include="..\Stringline.Gateway\Stringline.Gateway.csproj" />
    <ProjectReference Include="..\Stringline.Timetable\Stringline.Timetable.csproj" />
    <ProjectReference Include="..\Stringline.Network\Stringline.Network.csproj" />
    <ProjectReference Include="..\Stringline.Planning\Stringline.Planning.csproj" />
    <ProjectReference Include="..\Stringline.Persistence\Stringline.Persistence.csproj" />
    <ProjectReference Include="..\Stringline.Graph\Stringline.Graph.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="SkiaSharp.Views.WPF" />
  </ItemGroup>

</Project>
