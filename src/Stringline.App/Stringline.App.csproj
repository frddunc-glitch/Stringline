<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- SkiaSharp.Views.WPF 4.x ships only a windows10.0.19041 build (Windows 10 2004 or later). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Lets Linux tooling (e.g. GitHub's NuGet dependency submission) restore the full solution. No effect on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Stringline.App</RootNamespace>
    <AssemblyName>Stringline</AssemblyName>
    <!-- WPF needs culture data (XmlLanguage); the libraries stay invariant. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Stringline.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stringline.Core\Stringline.Core.csproj" />
    <ProjectReference Include="..\Stringline.Gateway\Stringline.Gateway.csproj" />
    <ProjectReference Include="..\Stringline.Timetable\Stringline.Timetable.csproj" />
    <ProjectReference Include="..\Stringline.Network\Stringline.Network.csproj" />
    <ProjectReference Include="..\Stringline.Planning\Stringline.Planning.csproj" />
    <ProjectReference Include="..\Stringline.Persistence\Stringline.Persistence.csproj" />
    <ProjectReference Include="..\Stringline.Graph\Stringline.Graph.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="SkiaSharp.Views.WPF" />
  </ItemGroup>

</Project>
