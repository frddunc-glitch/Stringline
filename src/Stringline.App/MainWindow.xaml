<Window x:Class="Stringline.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Stringline.App.Controls"
        xmlns:views="clr-namespace:Stringline.App.Views"
        Title="{Binding Title}" Height="860" Width="1600" MinWidth="800" MinHeight="480"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <views:NotNullToVisibilityConverter x:Key="NotNull" />
    <views:StatusLightBrushConverter x:Key="LightBrush" />
    <views:InfoSeverityBrushConverter x:Key="InfoBrush" />
    <Style TargetType="Button" x:Key="ToolButton">
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="2,0" />
    </Style>
  </Window.Resources>
  <Window.InputBindings>
    <KeyBinding Key="F5" Command="{Binding ConnectCommand}" />
    <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenReplayCommand}" />
    <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding LoadTimetableCommand}" />
    <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding ExportPngCommand}" CommandParameter="1" />
    <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
    <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}" />
    <KeyBinding Key="Z" Modifiers="Ctrl+Shift" Command="{Binding RedoCommand}" />
  </Window.InputBindings>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_Session">
        <MenuItem Header="_Connect to SimSig…" InputGestureText="F5" Command="{Binding ConnectCommand}" />
        <MenuItem Header="Open _replay…" InputGestureText="Ctrl+O" Command="{Binding OpenReplayCommand}" />
        <MenuItem Header="_Disconnect" Command="{Binding DisconnectCommand}" />
        <Separator />
        <MenuItem Header="_Record to file" IsCheckable="False" IsChecked="{Binding IsRecording, Mode=OneWay}" Command="{Binding ToggleRecordingCommand}" />
        <Separator />
        <MenuItem Header="_Export graph as PNG…" InputGestureText="Ctrl+E" Command="{Binding ExportPngCommand}" CommandParameter="1" />
        <MenuItem Header="Export graph as PNG at _2× size…" Command="{Binding ExportPngCommand}" CommandParameter="2" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_Timetable">
        <MenuItem Header="_Load timetable…" InputGestureText="Ctrl+T" Command="{Binding LoadTimetableCommand}" />
        <MenuItem Header="Show import _warnings" Command="{Binding ShowWarningsCommand}" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Follow now" InputGestureText="Space" Command="{Binding FollowCommand}" />
        <Separator />
        <MenuItem Header="_1 hour" Command="{Binding ZoomCommand}" CommandParameter="1" />
        <MenuItem Header="_3 hours" Command="{Binding ZoomCommand}" CommandParameter="3" />
        <MenuItem Header="_6 hours" Command="{Binding ZoomCommand}" CommandParameter="6" />
        <MenuItem Header="_Whole corridor" Command="{Binding ShowFullCorridorCommand}" />
        <Separator />
        <MenuItem Header="Show _WTT" IsCheckable="True" IsChecked="{Binding ShowWtt}" />
        <MenuItem Header="Show _actual" IsCheckable="True" IsChecked="{Binding ShowActual}" />
        <MenuItem Header="Show _forecast" IsCheckable="True" IsChecked="{Binding ShowForecast}" />
        <MenuItem Header="Show _disruptions and notes" IsCheckable="True" IsChecked="{Binding ShowDisruptions}" />
        <MenuItem Header="Forecast _knock-on from other trains" IsCheckable="True" IsChecked="{Binding ForecastKnockOn}"
                  ToolTip="Hold trains in the forecast for headways and single lines, so a late train delays the ones behind it" />
        <MenuItem Header="Colour by _delay" IsCheckable="True" IsChecked="{Binding ColourByDelay}" />
        <MenuItem Header="_Vertical (time down)" IsCheckable="True" IsChecked="{Binding IsVertical}" />
        <Separator />
        <MenuItem Header="_Clear selection" Command="{Binding ClearSelectionCommand}" />
      </MenuItem>
      <MenuItem Header="_Plan">
        <MenuItem Header="{Binding UndoHeader}" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
        <MenuItem Header="{Binding RedoHeader}" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
        <Separator />
        <MenuItem Header="Reset selected train to _WTT" Command="{Binding ResetSelectedCommand}" />
        <MenuItem Header="_Cancel or reinstate selected train" Command="{Binding CancelSelectedCommand}" />
        <MenuItem Header="Cl_one selected train as ad-hoc…" Command="{Binding CloneSelectedCommand}" />
        <MenuItem Header="_Link selected live train to WTT train…" Command="{Binding LinkSelectedCommand}" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About Stringline" Click="OnAbout" />
      </MenuItem>
    </Menu>

    <!-- Toolbar: session, corridor tabs, layers, zoom -->
    <Border DockPanel.Dock="Top" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="4,3" Background="#FAFAFA">
      <DockPanel LastChildFill="True">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
          <Button Style="{StaticResource ToolButton}" Content="Connect…" Command="{Binding ConnectCommand}" ToolTip="Connect to the SimSig Interface Gateway (F5)" />
          <Button Style="{StaticResource ToolButton}" Content="Replay…" Command="{Binding OpenReplayCommand}" ToolTip="Replay a recording (Ctrl+O)" />
          <Button Style="{StaticResource ToolButton}" Content="Disconnect" Command="{Binding DisconnectCommand}" />
          <ToggleButton Margin="6,0,2,0" Padding="8,2" IsChecked="{Binding IsRecording, Mode=OneWay}" Command="{Binding ToggleRecordingCommand}"
                        ToolTip="Record the live connection to a .sslog file">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="9" Height="9" Fill="#C62828" Margin="0,0,5,0" VerticalAlignment="Center" />
              <TextBlock Text="Rec" />
            </StackPanel>
          </ToggleButton>
          <Separator Margin="6,0" />
          <Button Style="{StaticResource ToolButton}" Content="Timetable…" Command="{Binding LoadTimetableCommand}" ToolTip="Load the sim's timetable (Ctrl+T)" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <CheckBox Content="WTT" IsChecked="{Binding ShowWtt}" Margin="6,0" VerticalAlignment="Center" />
          <CheckBox Content="Actual" IsChecked="{Binding ShowActual}" Margin="6,0" VerticalAlignment="Center" />
          <CheckBox Content="Forecast" IsChecked="{Binding ShowForecast}" Margin="6,0" VerticalAlignment="Center"
                    ToolTip="Dashed lines: where each running train is expected to go" />
          <CheckBox Content="Disruptions" IsChecked="{Binding ShowDisruptions}" Margin="6,0" VerticalAlignment="Center"
                    ToolTip="Blocks, speed restrictions and notes. Right-click the graph to add one, or hold B and drag to draw a block." />
          <TextBlock Text="Colour:" Margin="8,0,4,0" VerticalAlignment="Center" />
          <ComboBox Width="84" ItemsSource="{Binding ColourModes}" SelectedItem="{Binding ColourMode}" VerticalAlignment="Center"
                    ToolTip="Colour actual lines by train category, or by delay band (green right time, amber 1–5 min, orange 6–15, red over 15)" />
          <ToggleButton Margin="6,0,2,0" Padding="8,2" Content="⇅ Vertical" IsChecked="{Binding IsVertical}" ToolTip="Time down the graph, the corridor across" />
          <Separator Margin="6,0" />
          <Button Style="{StaticResource ToolButton}" Content="1h" Command="{Binding ZoomCommand}" CommandParameter="1" />
          <Button Style="{StaticResource ToolButton}" Content="3h" Command="{Binding ZoomCommand}" CommandParameter="3" />
          <Button Style="{StaticResource ToolButton}" Content="6h" Command="{Binding ZoomCommand}" CommandParameter="6" />
          <ToggleButton Margin="6,0,2,0" Padding="8,2" Content="Follow" IsChecked="{Binding IsFollowing, Mode=OneWay}" Command="{Binding ToggleFollowCommand}"
                        ToolTip="Keep the now line in view (Space)" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Corridors}" SelectedItem="{Binding SelectedCorridor}" DisplayMemberPath="Name"
                 BorderThickness="0" Background="Transparent" Margin="12,0" VerticalAlignment="Center"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ToolTip="Corridors">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="10,3" />
              <Setter Property="Margin" Value="1,0" />
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Status bar -->
    <StatusBar DockPanel.Dock="Bottom" Padding="4,0">
      <StatusBarItem>
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="10" Height="10" Fill="{Binding ConnectionLight, Converter={StaticResource LightBrush}}" Margin="0,0,6,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ConnectionText}" />
        </StackPanel>
      </StatusBarItem>
      <Separator />
      <StatusBarItem Content="{Binding SimName}" />
      <Separator />
      <StatusBarItem>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding ClockText}" FontFamily="Consolas" />
          <TextBlock Text="{Binding SpeedText}" Margin="8,0,0,0" />
        </StackPanel>
      </StatusBarItem>
      <Separator />
      <StatusBarItem Content="{Binding TrainsText}" />
      <Separator />
      <StatusBarItem>
        <TextBlock Text="{Binding EditStatus}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EditStatus}" />
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <TextBlock Text="{Binding RecordingText}" Foreground="#C62828" />
      </StatusBarItem>
    </StatusBar>

    <!-- Replay transport -->
    <Border DockPanel.Dock="Bottom" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="6,4" Background="#FAFAFA"
            DataContext="{Binding Transport}" Visibility="{Binding Converter={StaticResource NotNull}}">
      <DockPanel>
        <Button DockPanel.Dock="Left" Width="70" Command="{Binding PlayPauseCommand}">
          <Button.Style>
            <Style TargetType="Button">
              <Setter Property="Content" Value="▶ Play" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                  <Setter Property="Content" Value="❚❚ Pause" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <ComboBox DockPanel.Dock="Left" Width="70" Margin="6,0" ItemsSource="{Binding Speeds}" SelectedItem="{Binding Speed}" ToolTip="Replay speed" />
        <TextBlock DockPanel.Dock="Left" Text="{Binding PositionText}" FontFamily="Consolas" VerticalAlignment="Center" Margin="6,0" />
        <TextBlock DockPanel.Dock="Right" Text="{Binding RangeText}" Foreground="#757575" VerticalAlignment="Center" Margin="6,0" />
        <Slider x:Name="SeekBar" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Position}"
                IsMoveToPointEnabled="True" VerticalAlignment="Center" ToolTip="Seek"
                PreviewMouseLeftButtonDown="OnSeekStarted" PreviewMouseLeftButtonUp="OnSeekFinished" />
      </DockPanel>
    </Border>

    <!-- Info bar -->
    <Border DockPanel.Dock="Top" Padding="8,5" Background="{Binding InfoSeverity, Converter={StaticResource InfoBrush}}"
            Visibility="{Binding InfoMessage, Converter={StaticResource NotNull}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" Command="{Binding DismissInfoCommand}" ToolTip="Dismiss" Background="Transparent" BorderThickness="0" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <ComboBox Width="320" ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedSuggestion}" Margin="4,0"
                    Visibility="{Binding InfoHasSuggestions, Converter={StaticResource BoolToVisibility}}" />
          <Button Content="Load" Padding="10,1" Margin="2,0" Command="{Binding LoadSuggestionCommand}"
                  Visibility="{Binding InfoHasSuggestions, Converter={StaticResource BoolToVisibility}}" />
          <Button Content="Show warnings" Padding="10,1" Margin="2,0" Command="{Binding ShowWarningsCommand}"
                  Visibility="{Binding InfoHasWarnings, Converter={StaticResource BoolToVisibility}}" />
          <Button Content="Browse…" Padding="10,1" Margin="2,0,8,0" Command="{Binding LoadTimetableCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding InfoMessage}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <!-- Train list | graph | detail and history -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="330" MinWidth="180" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" MinWidth="300" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="490" MinWidth="240" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0" DataContext="{Binding Trains}">
        <StackPanel DockPanel.Dock="Top" Margin="6,6,6,4">
          <DockPanel>
            <TextBlock Text="Trains" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Summary}" Foreground="#757575" Margin="8,0,0,0" VerticalAlignment="Center" />
          </DockPanel>
          <DockPanel Margin="0,4,0,0">
            <ComboBox DockPanel.Dock="Right" Width="90" Margin="4,0,0,0" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" ToolTip="Sort by" />
            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter by headcode, location or train" />
          </DockPanel>
          <CheckBox Content="Not matched only" IsChecked="{Binding UnmatchedOnly}" Margin="0,4,0,0" />
        </StackPanel>
        <DataGrid x:Name="TrainGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserSortColumns="False" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"
                  GridLinesVisibility="None" RowHeaderWidth="0" BorderThickness="0,1,0,0" MouseDoubleClick="OnTrainDoubleClick"
                  EnableRowVirtualization="True" AlternatingRowBackground="#FAFAFA">
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsUnmatched}" Value="True">
                  <Setter Property="Foreground" Value="#757575" />
                  <Setter Property="FontStyle" Value="Italic" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridTemplateColumn Width="10">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Rectangle Width="4" Fill="{Binding Colour}" Margin="1,1" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Train" Binding="{Binding Headcode}" Width="52" FontWeight="SemiBold" />
            <DataGridTextColumn Header="Delay" Binding="{Binding DelayText}" Width="42">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Last at" Binding="{Binding LastLocation}" Width="*" />
            <DataGridTextColumn Header="Time" Binding="{Binding LastSeenText}" Width="60" />
            <DataGridTextColumn Header="WTT" Binding="{Binding StatusText}" Width="62" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#EEEEEE" />

      <Grid Grid.Column="2">
        <controls:GraphView x:Name="Graph" Scene="{Binding Scene}" Selection="{Binding Selection}" Navigator="{Binding Navigator}" Ghosts="{Binding Ghosts}" Draft="{Binding DraftDisruption}">
          <controls:GraphView.InputBindings>
            <KeyBinding Key="Space" Command="{Binding ToggleFollowCommand}" />
            <KeyBinding Key="Escape" Command="{Binding ClearSelectionCommand}" />
          </controls:GraphView.InputBindings>
        </controls:GraphView>
        <TextBlock Text="{Binding Placeholder}" Visibility="{Binding Placeholder, Converter={StaticResource NotNull}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Foreground="#757575" IsHitTestVisible="False" />
      </Grid>

      <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#EEEEEE" />

      <Grid Grid.Column="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="2*" MinHeight="140" />
          <RowDefinition Height="5" />
          <RowDefinition Height="*" MinHeight="90" />
        </Grid.RowDefinitions>

        <!-- Train detail (RP-1) -->
        <DockPanel Grid.Row="0">
          <StackPanel DockPanel.Dock="Top" Margin="6,6,6,4">
            <DockPanel>
              <Rectangle Width="4" Fill="{Binding Detail.Colour}" Margin="0,1,6,1"
                         Visibility="{Binding Detail.Heading, Converter={StaticResource NotNull}}" />
              <TextBlock Text="{Binding Detail.Heading}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Detail.StatusText}" Foreground="#616161" Margin="8,0,0,0" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail.StatusText}" />
            </DockPanel>
            <TextBlock Text="{Binding Detail.Description}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail.Description}" Margin="0,2,0,0"
                       Visibility="{Binding Detail.Description, Converter={StaticResource NotNull}}" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding Detail.Heading, Converter={StaticResource NotNull}}">
              <Button Style="{StaticResource ToolButton}" Margin="0,0,4,0" Content="Reset to WTT" Command="{Binding ResetSelectedCommand}"
                      ToolTip="Put the train back as the WTT books it" />
              <Button Style="{StaticResource ToolButton}" Margin="0,0,4,0" Content="{Binding CancelSelectedText}" Command="{Binding CancelSelectedCommand}" />
              <Button Style="{StaticResource ToolButton}" Margin="0,0,4,0" Content="Clone…" Command="{Binding CloneSelectedCommand}"
                      ToolTip="Copy the train's plan as an ad-hoc train with a new headcode" />
              <Button Style="{StaticResource ToolButton}" Margin="0,0,4,0" Content="Link…" Command="{Binding LinkSelectedCommand}"
                      ToolTip="Link the live train to a WTT train by hand" />
            </StackPanel>
          </StackPanel>
          <Grid>
            <DataGrid x:Name="ScheduleGrid" ItemsSource="{Binding Detail.Rows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserSortColumns="False" CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="Cell" HeadersVisibility="Column"
                      GridLinesVisibility="None" RowHeaderWidth="0" BorderThickness="0,1,0,0" AlternatingRowBackground="#FAFAFA"
                      Visibility="{Binding Detail.HasTrain, Converter={StaticResource BoolToVisibility}}">
              <DataGrid.Resources>
                <!-- Passes are italic; edited times bold. A stop's arrival is on its top line, its departure on the bottom. -->
                <Style x:Key="Passes" TargetType="TextBlock">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPass}" Value="True">
                      <Setter Property="FontStyle" Value="Italic" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
                <Style x:Key="PlanArrive" TargetType="TextBlock">
                  <Setter Property="VerticalAlignment" Value="Top" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding TimesChanged}" Value="True">
                      <Setter Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
                <Style x:Key="PlanDepart" TargetType="TextBlock" BasedOn="{StaticResource Passes}">
                  <Setter Property="VerticalAlignment" Value="Bottom" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding TimesChanged}" Value="True">
                      <Setter Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGrid.Resources>
              <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Runs}" Value="False">
                      <Setter Property="Foreground" Value="#9E9E9E" />
                      <Setter Property="FontStyle" Value="Italic" />
                      <Setter Property="ToolTip" Value="Not run: the train is terminated short before here" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGrid.RowStyle>
              <DataGrid.Columns>
                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*" MinWidth="70" IsReadOnly="True">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="ToolTip" Value="{Binding Tiploc}" />
                      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Plat" Binding="{Binding PlatformText}" Width="36">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding PlatformChanged}" Value="True">
                          <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Line" Binding="{Binding LineText}" Width="36">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding LineChanged}" Value="True">
                          <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="WTT" Binding="{Binding WttText}" Width="Auto" MinWidth="44" IsReadOnly="True" Foreground="#757575" ElementStyle="{StaticResource Passes}" />
                <DataGridTextColumn Header="Plan arr" Binding="{Binding PlanArriveText}" Width="Auto" MinWidth="50" ElementStyle="{StaticResource PlanArrive}" />
                <DataGridTextColumn Header="Plan dep" Binding="{Binding PlanDepartText}" Width="Auto" MinWidth="50" ElementStyle="{StaticResource PlanDepart}" />
                <DataGridTextColumn Header="Actual" Binding="{Binding ActualText}" Width="Auto" MinWidth="50" IsReadOnly="True" />
                <DataGridTextColumn Header="Forecast" Binding="{Binding ForecastText}" Width="Auto" MinWidth="56" IsReadOnly="True" Foreground="#1565C0" />
                <DataGridTextColumn Header="Delay" Binding="{Binding DelayText}" Width="36" IsReadOnly="True">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="HorizontalAlignment" Value="Right" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Select a train on the graph or in the list to see its schedule. Drag its line to retime it, or right-click it for more."
                       TextWrapping="Wrap" Foreground="#757575" Margin="12" HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Center"
                       Visibility="{Binding Detail.Heading, Converter={StaticResource NotNull}, ConverterParameter=invert}" />
          </Grid>
        </DockPanel>

        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#EEEEEE" />

        <!-- Edit history (RP-7) -->
        <DockPanel Grid.Row="2">
          <DockPanel DockPanel.Dock="Top" Margin="6,4">
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="↷ Redo" Command="{Binding RedoCommand}"
                    ToolTip="{Binding RedoTip}" ToolTipService.ShowOnDisabled="True" />
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="↶ Undo" Command="{Binding UndoCommand}"
                    ToolTip="{Binding UndoTip}" ToolTipService.ShowOnDisabled="True" />
            <TextBlock Text="Edit history" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding History.Summary}" Foreground="#757575" Margin="8,0,0,0" VerticalAlignment="Center" />
          </DockPanel>
          <ListBox x:Name="HistoryList" ItemsSource="{Binding History.Entries}" BorderThickness="0,1,0,0" HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Text="{Binding Number, StringFormat={}{0}.}" Foreground="#9E9E9E" Width="26" />
                  <TextBlock DockPanel.Dock="Left" Text="⚠ " Foreground="#EF6C00" ToolTip="{Binding Warnings}"
                             Visibility="{Binding Warnings, Converter={StaticResource NotNull}}" />
                  <TextBlock x:Name="EntryText" Text="{Binding Description}" TextWrapping="Wrap" />
                </DockPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsUndone}" Value="True">
                    <Setter TargetName="EntryText" Property="Foreground" Value="#9E9E9E" />
                    <Setter TargetName="EntryText" Property="FontStyle" Value="Italic" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
