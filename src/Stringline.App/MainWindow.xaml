<Window x:Class="Stringline.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Stringline.App.Controls"
        xmlns:views="clr-namespace:Stringline.App.Views"
        xmlns:services="clr-namespace:Stringline.App.Services"
        xmlns:local="clr-namespace:Stringline.App"
        Title="{Binding Title}" Icon="pack://application:,,,/Stringline;component/Assets/stringline.ico" Height="860" Width="1600" MinWidth="1050" MinHeight="520"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        views:Help.Topic="{x:Static services:HelpTopics.Contents}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <views:NotNullToVisibilityConverter x:Key="NotNull" />
    <views:StatusLightBrushConverter x:Key="LightBrush" />
    <views:InfoSeverityBrushConverter x:Key="InfoBrush" />
    <views:DelayWordsConverter x:Key="DelayWords" />
    <Style TargetType="Button" x:Key="ToolButton">
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Margin" Value="2,0" />
    </Style>
    <!-- The toolbar's toggles and layer boxes, kept tight so two or three corridor tabs fit at 1280 px (S25) -->
    <Style TargetType="ToggleButton" x:Key="ToolToggle">
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Margin" Value="4,0,2,0" />
    </Style>
    <Style TargetType="CheckBox" x:Key="LayerBox">
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The side panels' lists (#2): one star-sized text column each, numbers sized to their content and right-aligned. -->
    <Style TargetType="DataGrid" x:Key="PanelGrid">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserSortColumns" Value="False" />
      <Setter Property="CanUserReorderColumns" Value="False" />
      <Setter Property="CanUserResizeRows" Value="False" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="None" />
      <Setter Property="RowHeaderWidth" Value="0" />
      <Setter Property="AlternatingRowBackground" Value="#FAFAFA" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style TargetType="DataGridColumnHeader" x:Key="RightHeader">
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
    <Style TargetType="TextBlock" x:Key="RightCell">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="2,0" />
    </Style>
    <!-- A delay in whole minutes (+3, 0, −1), with its tooltip in words: "3 min late", "On time", "1 min early" (#11). -->
    <Style TargetType="TextBlock" x:Key="DelayCell" BasedOn="{StaticResource RightCell}">
      <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource DelayWords}}" />
    </Style>
    <Style TargetType="TextBlock" x:Key="TrimCell">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Style>
  </Window.Resources>
  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Close" Executed="OnExit" />
    <CommandBinding Command="{x:Static local:MainWindow.AboutCommand}" Executed="OnAbout" />
  </Window.CommandBindings>
  <Window.InputBindings>
    <KeyBinding Key="F5" Command="{Binding ConnectCommand}" />
    <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenReplayCommand}" />
    <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding LoadTimetableCommand}" />
    <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding ExportPngCommand}" CommandParameter="1" />
    <KeyBinding Key="P" Modifiers="Ctrl" Command="{Binding ExportPdfCommand}" CommandParameter="a3" />
    <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
    <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}" />
    <KeyBinding Key="Z" Modifiers="Ctrl+Shift" Command="{Binding RedoCommand}" />
    <KeyBinding Key="R" Modifiers="Ctrl+Shift" Command="{Binding ReplanCommand}" />
    <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding ShowSettingsCommand}" />
    <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding SelectCorridorCommand}" CommandParameter="1" />
    <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding SelectCorridorCommand}" CommandParameter="2" />
    <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding SelectCorridorCommand}" CommandParameter="3" />
    <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding SelectCorridorCommand}" CommandParameter="4" />
    <KeyBinding Key="D5" Modifiers="Ctrl" Command="{Binding SelectCorridorCommand}" CommandParameter="5" />
    <KeyBinding Key="D6" Modifiers="Ctrl" Command="{Binding SelectCorridorCommand}" CommandParameter="6" />
    <KeyBinding Key="D7" Modifiers="Ctrl" Command="{Binding SelectCorridorCommand}" CommandParameter="7" />
    <KeyBinding Key="D8" Modifiers="Ctrl" Command="{Binding SelectCorridorCommand}" CommandParameter="8" />
    <KeyBinding Key="D9" Modifiers="Ctrl" Command="{Binding SelectCorridorCommand}" CommandParameter="9" />
  </Window.InputBindings>

  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Background="{Binding Background, ElementName=MainMenu}">
      <!-- The sim clock (#13) at the menu row's right, where there is room at any width; its size from Tools ▸ Options ▸ Display -->
      <Border x:Name="SimClock" DockPanel.Dock="Right" Padding="10,0,8,0"
              VerticalAlignment="Center" ToolTip="Sim time and speed. Tools ▸ Options ▸ Display sets the size.">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding SimClockText}" FontFamily="Consolas" FontWeight="Bold" FontSize="{Binding ClockFontSize}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding SpeedText}" Foreground="#616161" Margin="8,0,0,0" VerticalAlignment="Center"
                     FontSize="{Binding SpeedFontSize}" />
        </StackPanel>
      </Border>
      <!-- The menus (S25, #8; 05-…md §1 and its "spec vs build" table): File for things on disk, Session for the link to
           the sim, View for display switches only, Corridor for the corridor shown, Plan (the edit menu) for the working
           plan, Tools for options and the profile. Access keys are unique within each menu (MenuTests). -->
      <Menu x:Name="MainMenu">
        <MenuItem Header="_File">
          <MenuItem Header="_Load timetable…" InputGestureText="Ctrl+T" Command="{Binding LoadTimetableCommand}" />
          <MenuItem Header="Timetable import _warnings" Command="{Binding ShowWarningsCommand}" />
          <Separator />
          <MenuItem Header="_Resume saved session…" Command="{Binding ResumeSessionCommand}" />
          <MenuItem Header="Re_view saved session…" Command="{Binding ReviewSessionCommand}" />
          <Separator />
          <MenuItem Header="_Export">
            <MenuItem Header="Graph as _PNG…" InputGestureText="Ctrl+E" Command="{Binding ExportPngCommand}" CommandParameter="1" />
            <MenuItem Header="Graph as PNG at _2× size…" Command="{Binding ExportPngCommand}" CommandParameter="2" />
            <MenuItem Header="Graph as PDF (_A3 landscape)…" InputGestureText="Ctrl+P" Command="{Binding ExportPdfCommand}" CommandParameter="a3" />
            <MenuItem Header="Graph as PDF (A_4 landscape)…" Command="{Binding ExportPdfCommand}" CommandParameter="a4" />
            <MenuItem Header="Graph as PDF (_view size)…" Command="{Binding ExportPdfCommand}" CommandParameter="view" />
            <MenuItem Header="P_lot (multi-page PDF)…" Command="{Binding ExportPlotCommand}"
                      ToolTip="A corridor over a stretch of time at one scale, across as many pages as it takes, time running down as on a printed train control diagram" />
            <Separator />
            <MenuItem Header="_Delay table as CSV…" Command="{Binding ExportDelaysCommand}" CommandParameter="points" />
            <MenuItem Header="_Train delays as CSV…" Command="{Binding ExportDelaysCommand}" CommandParameter="trains" />
          </MenuItem>
          <Separator />
          <MenuItem Header="E_xit" InputGestureText="Alt+F4" Command="ApplicationCommands.Close" />
        </MenuItem>
        <MenuItem Header="_Session">
          <MenuItem Header="_Connect to SimSig…" InputGestureText="F5" Command="{Binding ConnectCommand}" />
          <MenuItem Header="Open re_play…" InputGestureText="Ctrl+O" Command="{Binding OpenReplayCommand}" />
          <MenuItem Header="_Disconnect" Command="{Binding DisconnectCommand}" />
          <Separator />
          <MenuItem Header="_Record to file" IsCheckable="False" IsChecked="{Binding IsRecording, Mode=OneWay}" Command="{Binding ToggleRecordingCommand}" />
          <Separator />
          <MenuItem Header="_Assist: send commands to SimSig…" IsCheckable="False" IsChecked="{Binding AssistEnabled, Mode=OneWay}"
                    Command="{Binding ToggleAssistCommand}" ToolTip="{Binding AssistTip}" ToolTipService.ShowOnDisabled="True" />
        </MenuItem>
        <MenuItem Header="_View">
          <MenuItem Header="_Follow now" InputGestureText="Space" Command="{Binding FollowCommand}" />
          <Separator />
          <MenuItem Header="_1 hour" Command="{Binding ZoomCommand}" CommandParameter="1" />
          <MenuItem Header="_3 hours" Command="{Binding ZoomCommand}" CommandParameter="3" />
          <MenuItem Header="_6 hours" Command="{Binding ZoomCommand}" CommandParameter="6" />
          <Separator />
          <MenuItem Header="Show _WTT" IsCheckable="True" IsChecked="{Binding ShowWtt}" />
          <MenuItem Header="Show not-_running trains" IsCheckable="True" IsChecked="{Binding ShowNotRunning}"
                    ToolTip="Trains SimSig will not run this session (not seeded, or another seed group) draw faintly on the WTT layer; untick to hide them" />
          <MenuItem Header="Show _actual" IsCheckable="True" IsChecked="{Binding ShowActual}" />
          <MenuItem Header="Show f_orecast" IsCheckable="True" IsChecked="{Binding ShowForecast}" />
          <MenuItem Header="Show live _head" IsCheckable="True" IsChecked="{Binding ShowLiveHead}"
                    ToolTip="Carry each running train's line on from its last report to now, along its forecast, ending in a dot. It stops short of the next timing point until the train reports it." />
          <MenuItem Header="Si_gnals" ToolTip="Signals placed from play (learned, or set in the profile's Signals tab), shown on the location axis; hover one for its ID">
            <MenuItem Header="_Off" IsCheckable="False" IsChecked="{Binding IsSignalsOff, Mode=OneWay}"
                      Command="{Binding SetSignalDisplayCommand}" CommandParameter="Off" />
            <MenuItem Header="_Ticks" IsCheckable="False" IsChecked="{Binding IsSignalTicks, Mode=OneWay}"
                      Command="{Binding SetSignalDisplayCommand}" CommandParameter="Ticks"
                      ToolTip="A short tick at the plot's edge for each: Down signals on the location names' side, Up on the other" />
            <MenuItem Header="_Rows" IsCheckable="False" IsChecked="{Binding IsSignalRows, Mode=OneWay}"
                      Command="{Binding SetSignalDisplayCommand}" CommandParameter="Rows"
                      ToolTip="A faint dotted row across the graph for each" />
          </MenuItem>
          <MenuItem Header="Show _disruptions and notes" IsCheckable="True" IsChecked="{Binding ShowDisruptions}" />
          <MenuItem Header="Show co_nflicts" IsCheckable="True" IsChecked="{Binding ShowConflicts}" />
          <Separator />
          <MenuItem Header="Colour by de_lay" IsCheckable="True" IsChecked="{Binding ColourByDelay}" />
          <MenuItem Header="_Vertical (time down)" IsCheckable="True" IsChecked="{Binding IsVertical}" />
          <Separator />
          <MenuItem Header="_Panels">
            <MenuItem Header="_Train list" IsCheckable="True" IsChecked="{Binding Layout.ShowTrainList}" />
            <MenuItem Header="_Side panel" IsCheckable="True" IsChecked="{Binding Layout.ShowSidePanel}" />
            <MenuItem Header="T_abs (conflicts, regulation, delays, history)" IsCheckable="True" IsChecked="{Binding Layout.ShowTabs}"
                      IsEnabled="{Binding Layout.ShowSidePanel}" />
          </MenuItem>
          <MenuItem Header="R_eset layout" Command="{Binding Layout.ResetLayoutCommand}"
                    ToolTip="Show every panel again at its first size" />
          <Separator />
          <!-- Boards (S21): a second graph in this window, and graphs in windows of their own, all on one clock -->
          <MenuItem Header="Spl_it view">
            <MenuItem Header="_Off" IsCheckable="False" IsChecked="{Binding Layout.IsSplitOff, Mode=OneWay}"
                      Command="{Binding Layout.SetSplitCommand}" CommandParameter="None" />
            <MenuItem Header="One _above the other" IsCheckable="False" IsChecked="{Binding Layout.IsSplitStacked, Mode=OneWay}"
                      Command="{Binding Layout.SetSplitCommand}" CommandParameter="Stacked"
                      ToolTip="A second graph under the main one, with its own corridor and the same time" />
            <MenuItem Header="_Side by side" IsCheckable="False" IsChecked="{Binding Layout.IsSplitSideBySide, Mode=OneWay}"
                      Command="{Binding Layout.SetSplitCommand}" CommandParameter="SideBySide"
                      ToolTip="A second graph beside the main one, with its own corridor and the same time" />
          </MenuItem>
          <MenuItem Header="New _board window" Command="{Binding NewBoardWindowCommand}"
                    ToolTip="A graph in a window of its own, e.g. for another monitor: its own corridor, the same time" />
          <MenuItem Header="_Close board windows" Command="{Binding CloseBoardWindowsCommand}" />
        </MenuItem>
        <!-- Every corridor (filled in by MainWindow from CorridorMenuItems), then the whole corridor's zoom -->
        <MenuItem x:Name="CorridorMenu" Header="_Corridor">
          <Separator x:Name="CorridorListEnd" />
          <MenuItem Header="_Whole corridor" Command="{Binding ShowFullCorridorCommand}"
                    ToolTip="Show the whole length of the corridor" />
        </MenuItem>
        <MenuItem Header="_Plan">
          <MenuItem Header="{Binding UndoHeader}" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
          <MenuItem Header="{Binding RedoHeader}" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
          <Separator />
          <MenuItem Header="Reset selected train to _WTT" Command="{Binding ResetSelectedCommand}" />
          <MenuItem Header="_Cancel or reinstate selected train" Command="{Binding CancelSelectedCommand}" />
          <MenuItem Header="Run selected train _anyway" Command="{Binding RunAnywaySelectedCommand}"
                    ToolTip="For a train SimSig will not run this session (not seeded, or another seed group): forecast it as if it will. Use it again to leave it to the start rules." />
          <MenuItem Header="Cl_one selected train as ad-hoc…" Command="{Binding CloneSelectedCommand}" />
          <MenuItem Header="_Link selected live train to WTT train…" Command="{Binding LinkSelectedCommand}" />
          <MenuItem Header="Clear _selection" InputGestureText="Esc" Command="{Binding ClearSelectionCommand}" />
          <Separator />
          <MenuItem Header="Forecast _knock-on from other trains" IsCheckable="True" IsChecked="{Binding ForecastKnockOn}"
                    ToolTip="Hold trains in the forecast for headways and single lines, so a late train delays the ones behind it" />
          <Separator />
          <!-- Re-plan the horizon (S20, FC-6) -->
          <MenuItem Header="{Binding ReplanHeader}" InputGestureText="Ctrl+Shift+R" Command="{Binding ReplanCommand}"
                    ToolTip="Clear the conflicts ahead all at once, by holding trains and moving them to other platforms (Tools ▸ Options ▸ Suggestions). Shown in the suggestions panel to preview and apply." />
        </MenuItem>
        <MenuItem Header="_Tools">
          <MenuItem Header="_Options…" InputGestureText="Ctrl+," Command="{Binding ShowSettingsCommand}" />
          <Separator />
          <MenuItem Header="_Edit profile…" Command="{Binding EditProfileCommand}" />
          <MenuItem Header="Open profile _file" Command="{Binding OpenProfileFileCommand}" />
          <MenuItem Header="_Reload profile" Command="{Binding ReloadProfileCommand}" />
          <MenuItem Header="Re_generate corridors…" Command="{Binding RegenerateCorridorsCommand}" />
          <Separator />
          <!-- Sharing a profile (S37, #19): with its learned signal places -->
          <MenuItem Header="E_xport profile…" Command="{Binding ExportProfileCommand}"
                    ToolTip="Save this sim's profile, with its learned signal places, to share it" />
          <MenuItem Header="_Import profile…" Command="{Binding ImportProfileCommand}"
                    ToolTip="Use a profile someone shared for this sim: merge its learned signal places into yours, or replace yours with it" />
        </MenuItem>
        <MenuItem Header="_Help">
          <!-- The bundled guide's contents (S28); F1 opens the page for the panel or window with the focus (Views.Help) -->
          <MenuItem Header="_User guide" InputGestureText="F1" Command="ApplicationCommands.Help" CommandParameter="contents" />
          <MenuItem Header="_Getting started (online)" Command="{Binding OpenHelpCommand}" />
          <MenuItem Header="Open _log folder" Command="{Binding OpenLogFolderCommand}" />
          <!-- The privacy policy (S30, #14): the guide's copy of PRIVACY.md -->
          <MenuItem Header="_Privacy" Command="{Binding OpenGuideCommand}" CommandParameter="{x:Static services:HelpTopics.Privacy}" />
          <Separator />
          <MenuItem Header="_About Stringline" Command="{x:Static local:MainWindow.AboutCommand}" />
        </MenuItem>
      </Menu>
    </DockPanel>

    <!-- Toolbar: session, corridor tabs, layers, zoom -->
    <Border DockPanel.Dock="Top" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="4,3" Background="#FAFAFA">
      <DockPanel LastChildFill="True">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
          <Button Style="{StaticResource ToolButton}" Content="Connect…" Command="{Binding ConnectCommand}" ToolTip="Connect to the SimSig Interface Gateway (F5)" />
          <Button Style="{StaticResource ToolButton}" Content="Replay…" Command="{Binding OpenReplayCommand}" ToolTip="Replay a recording (Ctrl+O)" />
          <Button Style="{StaticResource ToolButton}" Content="Disconnect" Command="{Binding DisconnectCommand}" ToolTip="End the live connection or replay" />
          <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding IsRecording, Mode=OneWay}" Command="{Binding ToggleRecordingCommand}"
                        ToolTip="Record the live connection to a .sslog file">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="9" Height="9" Fill="#C62828" Margin="0,0,5,0" VerticalAlignment="Center" />
              <TextBlock Text="Rec" />
            </StackPanel>
          </ToggleButton>
          <Separator Margin="4,0" />
          <Button Style="{StaticResource ToolButton}" Content="Timetable…" Command="{Binding LoadTimetableCommand}" ToolTip="Load the sim's timetable (Ctrl+T)" />
        </StackPanel>
        <StackPanel x:Name="ToolbarRight" Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <CheckBox Style="{StaticResource LayerBox}" Content="WTT" IsChecked="{Binding ShowWtt}" ToolTip="The working timetable as booked (View ▸ Show WTT)" />
          <CheckBox Style="{StaticResource LayerBox}" Content="Actual" IsChecked="{Binding ShowActual}" ToolTip="Where the trains have run (View ▸ Show actual)" />
          <CheckBox Style="{StaticResource LayerBox}" Content="Forecast" IsChecked="{Binding ShowForecast}"
                    ToolTip="Dash-dot lines: where each running train is expected to go" />
          <CheckBox Style="{StaticResource LayerBox}" Content="Disruptions" IsChecked="{Binding ShowDisruptions}"
                    ToolTip="Blocks, speed restrictions and notes. Right-click the graph to add one, or hold B and drag to draw a block." />
          <CheckBox Style="{StaticResource LayerBox}" Content="Conflicts" IsChecked="{Binding ShowConflicts}"
                    ToolTip="Red rings where a train must give way: headways, single lines, platforms, blocks and run times. Click one, or pick it in the Conflicts list, to focus it." />
          <ToggleButton Style="{StaticResource ToolToggle}" Content="By delay" IsChecked="{Binding ColourByDelay}"
                        ToolTip="Colour actual lines by delay band (green on time or early, amber 1–5 min late, orange 6–15, red over 15), not by train category (View ▸ Colour by delay)" />
          <ToggleButton Style="{StaticResource ToolToggle}" Content="⇅ Vertical" IsChecked="{Binding IsVertical}" ToolTip="Time down the graph, the corridor across (View ▸ Vertical)" />
          <Separator Margin="4,0" />
          <Button Style="{StaticResource ToolButton}" Content="1h" Command="{Binding ZoomCommand}" CommandParameter="1" ToolTip="Show 1 hour across" />
          <Button Style="{StaticResource ToolButton}" Content="3h" Command="{Binding ZoomCommand}" CommandParameter="3" ToolTip="Show 3 hours across" />
          <Button Style="{StaticResource ToolButton}" Content="6h" Command="{Binding ZoomCommand}" CommandParameter="6" ToolTip="Show 6 hours across" />
          <ToggleButton Style="{StaticResource ToolToggle}" Content="Follow" IsChecked="{Binding IsFollowing, Mode=OneWay}" Command="{Binding ToggleFollowCommand}"
                        ToolTip="Keep the now line in view (Space)" />
        </StackPanel>
        <!-- Corridor tabs on one row (S25, Fred): those that do not fit are under », and all are in the Corridor menu -->
        <Button x:Name="MoreCorridors" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="»" Visibility="Collapsed"
                Click="OnMoreCorridors" ToolTip="Corridors that do not fit here (all are in the Corridor menu, Ctrl+1 to Ctrl+9)" />
        <ListBox x:Name="CorridorTabs" ItemsSource="{Binding Corridors}" SelectedItem="{Binding SelectedCorridor}" DisplayMemberPath="Name"
                 BorderThickness="0" Background="Transparent" Margin="6,0,2,0" VerticalAlignment="Center"
                 ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False" ScrollViewer.ScrollChanged="OnCorridorTabsScrolled"
                 SelectionChanged="OnCorridorTabChanged" ToolTip="Corridors (Ctrl+1 to Ctrl+9)">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="8,3" />
              <Setter Property="Margin" Value="1,0" />
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Status bar -->
    <StatusBar DockPanel.Dock="Bottom" Padding="4,0">
      <StatusBarItem>
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="10" Height="10" Fill="{Binding ConnectionLight, Converter={StaticResource LightBrush}}" Margin="0,0,6,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ConnectionText}" />
        </StackPanel>
      </StatusBarItem>
      <Separator />
      <StatusBarItem Content="{Binding SimTitleText}" />
      <Separator />
      <StatusBarItem>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding ClockText}" FontFamily="Consolas" />
          <TextBlock Text="{Binding SpeedText}" Margin="8,0,0,0" />
        </StackPanel>
      </StatusBarItem>
      <Separator />
      <StatusBarItem Content="{Binding TrainsText}" />
      <Separator />
      <StatusBarItem>
        <TextBlock Text="{Binding ConflictsText}" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock Text="{Binding EditStatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EditStatusText}" />
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <TextBlock Text="{Binding RecordingText}" Foreground="#C62828" />
      </StatusBarItem>
    </StatusBar>

    <!-- Replay transport -->
    <Border DockPanel.Dock="Bottom" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="6,4" Background="#FAFAFA"
            DataContext="{Binding Transport}" Visibility="{Binding Converter={StaticResource NotNull}}"
            views:Help.Topic="{x:Static services:HelpTopics.Replay}">
      <DockPanel>
        <Button DockPanel.Dock="Left" Width="70" Command="{Binding PlayPauseCommand}">
          <Button.Style>
            <Style TargetType="Button">
              <Setter Property="Content" Value="▶ Play" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                  <Setter Property="Content" Value="❚❚ Pause" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <ComboBox DockPanel.Dock="Left" Width="70" Margin="6,0" ItemsSource="{Binding Speeds}" SelectedItem="{Binding Speed}" ToolTip="Replay speed" />
        <TextBlock DockPanel.Dock="Left" Text="{Binding PositionText}" FontFamily="Consolas" VerticalAlignment="Center" Margin="6,0" />
        <TextBlock DockPanel.Dock="Right" Text="{Binding RangeText}" Foreground="#757575" VerticalAlignment="Center" Margin="6,0" />
        <Slider x:Name="SeekBar" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Position}"
                IsMoveToPointEnabled="True" VerticalAlignment="Center" ToolTip="Seek"
                PreviewMouseLeftButtonDown="OnSeekStarted" PreviewMouseLeftButtonUp="OnSeekFinished" />
      </DockPanel>
    </Border>

    <!-- Info bar -->
    <Border DockPanel.Dock="Top" Padding="8,5" Background="{Binding InfoSeverity, Converter={StaticResource InfoBrush}}"
            Visibility="{Binding InfoMessage, Converter={StaticResource NotNull}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" Command="{Binding DismissInfoCommand}" ToolTip="Dismiss" Background="Transparent" BorderThickness="0" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <ComboBox Width="320" ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedSuggestion}" Margin="4,0"
                    Visibility="{Binding InfoHasSuggestions, Converter={StaticResource BoolToVisibility}}" />
          <Button Content="Load" Padding="10,1" Margin="2,0" Command="{Binding LoadSuggestionCommand}"
                  Visibility="{Binding InfoHasSuggestions, Converter={StaticResource BoolToVisibility}}" />
          <Button Content="Show warnings" Padding="10,1" Margin="2,0" Command="{Binding ShowWarningsCommand}"
                  Visibility="{Binding InfoHasWarnings, Converter={StaticResource BoolToVisibility}}" />
          <Button Content="Resume" Padding="10,1" Margin="2,0" Command="{Binding ResumeOfferedCommand}"
                  Visibility="{Binding InfoHasResume, Converter={StaticResource BoolToVisibility}}" />
          <Button Content="Review" Padding="10,1" Margin="2,0,8,0" Command="{Binding ReviewOfferedCommand}"
                  Visibility="{Binding InfoHasResume, Converter={StaticResource BoolToVisibility}}" />
          <Button Content="Browse…" Padding="10,1" Margin="2,0,8,0" Command="{Binding LoadTimetableCommand}"
                  Visibility="{Binding InfoShowsBrowse, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        <TextBlock Text="{Binding InfoMessage}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <!-- Train list | graph | detail and tabs. Columns and rows are star-sized so they keep their share as the window
         changes size (#9); the window applies the saved layout and hides panels in code (MainWindow.Layout.cs). -->
    <Grid x:Name="Panels">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="TrainListColumn" Width="330*" MinWidth="{x:Static services:WindowLayout.MinTrainListWidth}" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition x:Name="GraphColumn" Width="780*" MinWidth="{x:Static services:WindowLayout.MinGraphWidth}" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition x:Name="SideColumn" Width="490*" MinWidth="{x:Static services:WindowLayout.MinSideWidth}" />
      </Grid.ColumnDefinitions>

      <DockPanel x:Name="TrainListPanel" Grid.Column="0" DataContext="{Binding Trains}" views:Help.Topic="{x:Static services:HelpTopics.TrainList}">
        <StackPanel DockPanel.Dock="Top" Margin="6,6,6,4">
          <DockPanel>
            <TextBlock Text="Trains" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Summary}" Foreground="#757575" Margin="8,0,0,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" />
          </DockPanel>
          <DockPanel Margin="0,4,0,0">
            <ComboBox DockPanel.Dock="Right" Width="90" Margin="4,0,0,0" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" ToolTip="Sort by" />
            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter by headcode, location or train" />
          </DockPanel>
          <CheckBox Content="Not matched only" IsChecked="{Binding UnmatchedOnly}" Margin="0,4,0,0" />
        </StackPanel>
        <DataGrid x:Name="TrainGrid" Style="{StaticResource PanelGrid}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                  BorderThickness="0,1,0,0" MouseDoubleClick="OnTrainDoubleClick" EnableRowVirtualization="True">
          <DataGrid.GroupStyle>
            <!-- Live trains have no header; trains SimSig will not run this session (S34) come after them under "Not running". -->
            <GroupStyle>
              <GroupStyle.ContainerStyle>
                <Style TargetType="GroupItem">
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="GroupItem">
                        <StackPanel>
                          <ContentPresenter />
                          <ItemsPresenter />
                        </StackPanel>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </GroupStyle.ContainerStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock x:Name="GroupHeader" Text="{Binding Name}" FontWeight="SemiBold" Foreground="#757575" Margin="4,6,0,2"
                             ToolTip="Trains SimSig will not run this session: not seeded and booked before the start, seeded in another seed group, or formed from such a train. Right-click one on the graph, or use the train detail, to run it anyway." />
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Name}" Value="">
                      <Setter TargetName="GroupHeader" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </DataGrid.GroupStyle>
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsUnmatched}" Value="True">
                  <Setter Property="Foreground" Value="#757575" />
                  <Setter Property="FontStyle" Value="Italic" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLive}" Value="False">
                  <Setter Property="Foreground" Value="#9E9E9E" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridTemplateColumn Width="10" CanUserResize="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Rectangle Width="4" Fill="{Binding Colour}" Margin="1,1" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Train" Binding="{Binding Headcode}" Width="Auto" MinWidth="44" FontWeight="SemiBold" />
            <DataGridTextColumn Header="Delay" Binding="{Binding DelayText}" Width="Auto" MinWidth="40"
                                HeaderStyle="{StaticResource RightHeader}" ElementStyle="{StaticResource DelayCell}" />
            <DataGridTextColumn Header="Last at" Binding="{Binding LastLocation}" Width="*" MinWidth="50" ElementStyle="{StaticResource TrimCell}" />
            <DataGridTextColumn Header="Time" Binding="{Binding LastSeenText}" Width="Auto" MinWidth="40" />
            <DataGridTextColumn Header="WTT" Binding="{Binding StatusText}" Width="Auto" MinWidth="40" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>

      <GridSplitter x:Name="TrainListSplitter" DragStarted="OnSplitterDragStarted" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#EEEEEE"
                    ToolTip="Drag to resize the train list; double-click to hide or show it"
                    MouseDoubleClick="OnSplitterDoubleClick" DragCompleted="OnSplitterDragCompleted" />

      <!-- The main graph and, with View ▸ Split view on, a second board under or beside it (S21; placed in MainWindow.Layout.cs) -->
      <Grid x:Name="BoardsArea" Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition x:Name="MainBoardRow" Height="*" />
          <RowDefinition x:Name="BoardSplitterRow" Height="0" />
          <RowDefinition x:Name="SplitBoardRow" Height="0" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="MainBoardColumn" Width="*" />
          <ColumnDefinition x:Name="BoardSplitterColumn" Width="0" />
          <ColumnDefinition x:Name="SplitBoardColumn" Width="0" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="MainBoardPane" views:Help.Topic="{x:Static services:HelpTopics.Graph}">
          <controls:GraphView x:Name="Graph" Scene="{Binding Scene}" Selection="{Binding Selection}" Navigator="{Binding Navigator}" Ghosts="{Binding Ghosts}" Grips="{Binding Grips}" Draft="{Binding DraftDisruption}">
            <controls:GraphView.InputBindings>
              <KeyBinding Key="Space" Command="{Binding ToggleFollowCommand}" />
              <KeyBinding Key="Escape" Command="{Binding ClearSelectionCommand}" />
            </controls:GraphView.InputBindings>
          </controls:GraphView>
          <TextBlock Text="{Binding Placeholder}" Visibility="{Binding Placeholder, Converter={StaticResource NotNull}}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Foreground="#757575" IsHitTestVisible="False"
                     TextWrapping="Wrap" TextAlignment="Center" Margin="12" />
        </Grid>
        <GridSplitter x:Name="BoardSplitter" Background="#EEEEEE" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed"
                      ToolTip="Drag to share the room between the two graphs" DragCompleted="OnSplitterDragCompleted" />
        <controls:BoardView x:Name="SplitBoardView" DataContext="{Binding SplitBoard}" Visibility="Collapsed" />
      </Grid>

      <GridSplitter x:Name="SideSplitter" DragStarted="OnSplitterDragStarted" Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#EEEEEE"
                    ToolTip="Drag to resize the side panel; double-click to hide or show it"
                    MouseDoubleClick="OnSplitterDoubleClick" DragCompleted="OnSplitterDragCompleted" />

      <Grid x:Name="SidePanel" Grid.Column="4">
        <Grid.RowDefinitions>
          <RowDefinition x:Name="DetailRow" Height="2*" MinHeight="{x:Static services:WindowLayout.MinDetailHeight}" />
          <RowDefinition Height="Auto" />
          <RowDefinition x:Name="TabsRow" Height="*" MinHeight="{x:Static services:WindowLayout.MinTabsHeight}" />
        </Grid.RowDefinitions>

        <!-- Train detail (RP-1) -->
        <DockPanel Grid.Row="0" views:Help.Topic="{x:Static services:HelpTopics.TrainDetail}">
          <StackPanel DockPanel.Dock="Top" Margin="6,6,6,4">
            <DockPanel>
              <Rectangle Width="4" Fill="{Binding Detail.Colour}" Margin="0,1,6,1"
                         Visibility="{Binding Detail.Heading, Converter={StaticResource NotNull}}" />
              <TextBlock Text="{Binding Detail.Heading}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Detail.StatusText}" Foreground="#616161" Margin="8,0,0,0" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail.StatusText}" />
            </DockPanel>
            <TextBlock Text="{Binding Detail.Description}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail.Description}" Margin="0,2,0,0"
                       Visibility="{Binding Detail.Description, Converter={StaticResource NotNull}}" />
            <WrapPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding Detail.Heading, Converter={StaticResource NotNull}}">
              <Button Style="{StaticResource ToolButton}" Margin="0,0,4,2" Content="Reset to WTT" Command="{Binding ResetSelectedCommand}"
                      ToolTip="Put the train back as the WTT books it" />
              <Button Style="{StaticResource ToolButton}" Margin="0,0,4,2" Content="{Binding CancelSelectedText}" Command="{Binding CancelSelectedCommand}" />
              <Button Style="{StaticResource ToolButton}" Margin="0,0,4,2" Content="{Binding RunAnywaySelectedText}" Command="{Binding RunAnywaySelectedCommand}"
                      Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVisibility}}"
                      ToolTip="SimSig will not run this train this session (not seeded, or another seed group). Run anyway forecasts it as if it will; it can be undone." />
              <Button Style="{StaticResource ToolButton}" Margin="0,0,4,2" Content="Clone…" Command="{Binding CloneSelectedCommand}"
                      ToolTip="Copy the train's plan as an ad-hoc train with a new headcode" />
              <Button Style="{StaticResource ToolButton}" Margin="0,0,4,2" Content="Link…" Command="{Binding LinkSelectedCommand}"
                      ToolTip="Link the live train to a WTT train by hand" />
            </WrapPanel>
          </StackPanel>
          <Grid>
            <DataGrid x:Name="ScheduleGrid" Style="{StaticResource PanelGrid}" ItemsSource="{Binding Detail.Rows}" IsReadOnly="False"
                      CanUserDeleteRows="False" SelectionUnit="Cell" BorderThickness="0,1,0,0"
                      Visibility="{Binding Detail.HasTrain, Converter={StaticResource BoolToVisibility}}">
              <DataGrid.Resources>
                <!-- Passes are italic; edited times bold. A stop's arrival is on its top line, its departure on the bottom. -->
                <Style x:Key="Passes" TargetType="TextBlock">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPass}" Value="True">
                      <Setter Property="FontStyle" Value="Italic" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
                <Style x:Key="PlanArrive" TargetType="TextBlock">
                  <Setter Property="VerticalAlignment" Value="Top" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding TimesChanged}" Value="True">
                      <Setter Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
                <Style x:Key="PlanDepart" TargetType="TextBlock" BasedOn="{StaticResource Passes}">
                  <Setter Property="VerticalAlignment" Value="Bottom" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding TimesChanged}" Value="True">
                      <Setter Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGrid.Resources>
              <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Runs}" Value="False">
                      <Setter Property="Foreground" Value="#9E9E9E" />
                      <Setter Property="FontStyle" Value="Italic" />
                      <Setter Property="ToolTip" Value="Not run: the train is terminated short before here" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGrid.RowStyle>
              <DataGrid.Columns>
                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*" MinWidth="70" IsReadOnly="True">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="ToolTip" Value="{Binding Tiploc}" />
                      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Plat" Binding="{Binding PlatformText}" Width="Auto" MinWidth="30">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding PlatformChanged}" Value="True">
                          <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Line" Binding="{Binding LineText}" Width="Auto" MinWidth="30">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding LineChanged}" Value="True">
                          <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="WTT" Binding="{Binding WttText}" Width="Auto" MinWidth="40" IsReadOnly="True" Foreground="#757575" ElementStyle="{StaticResource Passes}" />
                <DataGridTextColumn Header="Plan arr" Binding="{Binding PlanArriveText}" Width="Auto" MinWidth="40" ElementStyle="{StaticResource PlanArrive}" />
                <DataGridTextColumn Header="Plan dep" Binding="{Binding PlanDepartText}" Width="Auto" MinWidth="40" ElementStyle="{StaticResource PlanDepart}" />
                <DataGridTextColumn Header="Actual" Binding="{Binding ActualText}" Width="Auto" MinWidth="40" IsReadOnly="True" />
                <DataGridTextColumn Header="Forecast" Binding="{Binding ForecastText}" Width="Auto" MinWidth="40" IsReadOnly="True" Foreground="#1565C0" />
                <DataGridTextColumn Header="Delay" Binding="{Binding DelayText}" Width="Auto" MinWidth="36" IsReadOnly="True"
                                    HeaderStyle="{StaticResource RightHeader}" ElementStyle="{StaticResource DelayCell}" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Select a train on the graph or in the list to see its schedule. Drag its line to retime it, or right-click it for more."
                       TextWrapping="Wrap" Foreground="#757575" Margin="12" HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Center"
                       Visibility="{Binding Detail.Heading, Converter={StaticResource NotNull}, ConverterParameter=invert}" />
          </Grid>
        </DockPanel>

        <GridSplitter x:Name="TabsSplitter" DragStarted="OnSplitterDragStarted" Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#EEEEEE"
                      ToolTip="Drag to resize; double-click to hide or show the tabs"
                      MouseDoubleClick="OnSplitterDoubleClick" DragCompleted="OnSplitterDragCompleted" />

        <!-- Conflicts (FC-4, S14), regulation, delays and edit history (RP-7), as tabs (Fred) -->
        <TabControl x:Name="SideTabs" Grid.Row="2" BorderThickness="0,1,0,0" Padding="0" SelectedIndex="{Binding SideTab}">
          <TabItem Header="{Binding ConflictList.Header}" views:Help.Topic="{x:Static services:HelpTopics.Conflicts}">
            <Grid views:Help.Topic="{x:Static services:HelpTopics.Conflicts}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="SuggestionsRow" Height="0" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="{Binding ConflictList.Summary}" Foreground="#757575" Margin="6,4" TextTrimming="CharacterEllipsis"
                         ToolTip="Clashes still to come, on every corridor, by the forecast without knock-on. Pick one to show it on the graph and see suggestions." />
              <ListBox x:Name="ConflictsList" Grid.Row="1" ItemsSource="{Binding ConflictList.Rows}" SelectedItem="{Binding ConflictList.Selected}"
                       BorderThickness="0,1,0,0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       Grid.IsSharedSizeScope="True">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ToolTip="{Binding Tip}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ConflictTime" />
                        <ColumnDefinition Width="*" MinWidth="60" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ConflictTrains" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ConflictSeverity" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0" Background="#FDECEA" BorderBrush="#E51A1A" BorderThickness="1" CornerRadius="2" Margin="0,1,6,1"
                              ToolTip="{Binding Kind}">
                        <TextBlock Text="{Binding Badge}" Foreground="#B71C1C" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
                      </Border>
                      <TextBlock Grid.Column="1" Text="{Binding Time}" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <TextBlock Grid.Column="2" Text="{Binding Where}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <TextBlock Grid.Column="3" Text="{Binding Trains}" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <TextBlock Grid.Column="4" Text="{Binding Severity}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <!-- Suggestions for the picked conflict (FC-5, S15), under their own splitter (Fred) -->
              <GridSplitter x:Name="SuggestionsSplitter" Grid.Row="2" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#EEEEEE"
                            ToolTip="Drag to give the suggestions more or less room" DragCompleted="OnSplitterDragCompleted"
                            Visibility="{Binding SuggestionPanel.IsVisible, Converter={StaticResource BoolToVisibility}}" />
              <Border x:Name="SuggestionsPanel" Grid.Row="3" Background="#FAFAFA"
                      Visibility="{Binding SuggestionPanel.IsVisible, Converter={StaticResource BoolToVisibility}}">
                <DockPanel Margin="6,4">
                  <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="Close" Command="{Binding CloseReplanCommand}" VerticalAlignment="Center"
                            Visibility="{Binding SuggestionPanel.IsReplan, Converter={StaticResource BoolToVisibility}}" ToolTip="Close the re-plan." />
                    <CheckBox DockPanel.Dock="Right" Content="Allow cancelling" IsChecked="{Binding SuggestionPanel.AllowCancellation}" VerticalAlignment="Center"
                              Visibility="{Binding SuggestionPanel.IsReplan, Converter={StaticResource NotNull}, ConverterParameter=invert}"
                              ToolTip="Also suggest terminating a train short, or cancelling one not yet started, for a block." />
                    <TextBlock Text="{Binding SuggestionPanel.Heading}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               ToolTip="{Binding SuggestionPanel.Heading}" />
                  </DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="{Binding SuggestionPanel.Status}" Foreground="#757575" TextWrapping="Wrap" Margin="0,4,0,0"
                             Visibility="{Binding SuggestionPanel.Status, Converter={StaticResource NotNull}}" />
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SuggestionPanel.Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <DockPanel Margin="0,4,0,0" ToolTip="{Binding Tip}" Background="Transparent">
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="Apply" VerticalAlignment="Top"
                                    Command="{Binding DataContext.ApplySuggestionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                    ToolTip="Make this change to the plan, as one edit you can undo." />
                            <ToggleButton DockPanel.Dock="Right" Content="Preview" Padding="8,2" Margin="2,0" VerticalAlignment="Top"
                                          IsChecked="{Binding IsPreviewed, Mode=OneWay}"
                                          Command="{Binding DataContext.PreviewSuggestionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                          ToolTip="Draw the plans it changes on the graph." />
                            <StackPanel>
                              <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Detail}" Foreground="#616161" FontSize="11" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Steps}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                         Visibility="{Binding Steps, Converter={StaticResource NotNull}}" />
                            </StackPanel>
                          </DockPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </Border>
            </Grid>
          </TabItem>
          <!-- Regulation list (RP-9, S15) -->
          <TabItem Header="Regulation" views:Help.Topic="{x:Static services:HelpTopics.Regulation}">
            <DockPanel views:Help.Topic="{x:Static services:HelpTopics.Regulation}">
              <DockPanel DockPanel.Dock="Top" Margin="6,4">
                <TextBlock Text="At" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="RegulationLocations" ItemsSource="{Binding Regulation.Locations}" SelectedItem="{Binding Regulation.Location}"
                          DisplayMemberPath="Name" MinWidth="160" IsEditable="False"
                          ToolTip="The location to list; or right-click a location on the graph and choose Regulation list." />
              </DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="{Binding Regulation.Summary}" Foreground="#757575" Margin="6,0,6,4" TextWrapping="Wrap"
                         ToolTip="Movements still to come here, in the order of the working plan. Bold amber rows are out of WTT order." />
              <DataGrid x:Name="RegulationList" Style="{StaticResource PanelGrid}" ItemsSource="{Binding Regulation.Rows}" BorderThickness="0,1,0,0"
                        SelectedItem="{Binding Regulation.Selected}">
                <!-- Assist (S19): enabled while Session ▸ Assist is on -->
                <DataGrid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Re_quest route in SimSig…" Command="{Binding RequestRouteForRegulationCommand}"
                              ToolTip="{Binding AssistTip}" ToolTipService.ShowOnDisabled="True" />
                    <MenuItem Header="Interpose _description in SimSig…" Command="{Binding InterposeForRegulationCommand}"
                              ToolTip="{Binding AssistTip}" ToolTipService.ShowOnDisabled="True" />
                  </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.RowStyle>
                  <Style TargetType="DataGridRow">
                    <Setter Property="ToolTip" Value="{Binding Tip}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding OutOfOrder}" Value="True">
                        <Setter Property="Foreground" Value="#E65100" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Plan" Binding="{Binding Time}" Width="Auto" MinWidth="40" />
                  <DataGridTextColumn Header="Train" Binding="{Binding Headcode}" Width="Auto" MinWidth="40" />
                  <DataGridTextColumn Header="Does" Binding="{Binding Move}" Width="Auto" MinWidth="50" />
                  <DataGridTextColumn Header="Plat" Binding="{Binding Platform}" Width="Auto" MinWidth="30" />
                  <DataGridTextColumn Header="Fcst" Binding="{Binding Forecast}" Width="Auto" MinWidth="40" />
                  <DataGridTextColumn Header="Late" Binding="{Binding Delay}" Width="Auto" MinWidth="32"
                                      HeaderStyle="{StaticResource RightHeader}" ElementStyle="{StaticResource DelayCell}" />
                  <DataGridTextColumn Header="Order" Binding="{Binding Order}" Width="*" MinWidth="60" ElementStyle="{StaticResource TrimCell}" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>
          <!-- Delay table (SES-2, S17) -->
          <TabItem Header="Delays" views:Help.Topic="{x:Static services:HelpTopics.Delays}">
            <Grid views:Help.Topic="{x:Static services:HelpTopics.Delays}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" MinHeight="40" />
                <RowDefinition Height="5" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" MinHeight="40" />
              </Grid.RowDefinitions>
              <DockPanel Grid.Row="0" Margin="6,4">
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="CSV by train…" Command="{Binding ExportDelaysCommand}" CommandParameter="trains"
                        ToolTip="Save one row per train (where it is, its worst and final delay) as CSV." />
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="CSV…" Command="{Binding ExportDelaysCommand}" CommandParameter="points"
                        ToolTip="Save the delay table, one row per train and timing point, as CSV." />
                <TextBlock Text="Sort" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="DelaySort" ItemsSource="{Binding Delays.Options, Mode=OneTime}" SelectedItem="{Binding Delays.Sort}" MinWidth="100" />
                <CheckBox Content="All trains" IsChecked="{Binding Delays.ShowAll}" VerticalAlignment="Center" Margin="8,0,0,0"
                          ToolTip="List every train in the plan, not only those seen." />
              </DockPanel>
              <TextBlock Grid.Row="1" Text="{Binding Delays.Summary}" Foreground="#757575" Margin="6,0,6,4" TextWrapping="Wrap"
                         ToolTip="Delays are whole minutes against the WTT (against the plan for ad-hoc trains). Blue final delays are forecasts." />
              <DataGrid Grid.Row="2" x:Name="DelayTrains" Style="{StaticResource PanelGrid}" ItemsSource="{Binding Delays.Trains}" SelectedItem="{Binding Delays.Selected}"
                        BorderThickness="0,1,0,0">
                <DataGrid.RowStyle>
                  <Style TargetType="DataGridRow">
                    <Setter Property="ToolTip" Value="{Binding Tip}" />
                  </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Train" Binding="{Binding Headcode}" Width="Auto" MinWidth="40" />
                  <DataGridTextColumn Header="State" Binding="{Binding State}" Width="Auto" MinWidth="40" />
                  <DataGridTextColumn Header="Latest" Binding="{Binding Latest}" Width="3*" MinWidth="50" ElementStyle="{StaticResource TrimCell}" />
                  <DataGridTextColumn Header="Late" Binding="{Binding LatestDelay}" Width="Auto" MinWidth="32"
                                      HeaderStyle="{StaticResource RightHeader}" ElementStyle="{StaticResource DelayCell}" />
                  <DataGridTextColumn Header="Worst" Binding="{Binding WorstDelay}" Width="Auto" MinWidth="36"
                                      HeaderStyle="{StaticResource RightHeader}" ElementStyle="{StaticResource DelayCell}" />
                  <DataGridTextColumn Header="At" Binding="{Binding WorstAt}" Width="2*" MinWidth="40" ElementStyle="{StaticResource TrimCell}" />
                  <DataGridTemplateColumn Header="Final" Width="Auto" MinWidth="34" HeaderStyle="{StaticResource RightHeader}">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock x:Name="Final" Text="{Binding FinalDelay}" Style="{StaticResource DelayCell}" />
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding FinalIsForecast}" Value="True">
                            <Setter TargetName="Final" Property="Foreground" Value="#1565C0" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#EEEEEE" />
              <TextBlock Grid.Row="4" Text="{Binding Delays.PointsHeading}" FontWeight="SemiBold" Margin="6,2" TextTrimming="CharacterEllipsis" />
              <DataGrid Grid.Row="5" x:Name="DelayPoints" Style="{StaticResource PanelGrid}" ItemsSource="{Binding Delays.Points}" BorderThickness="0,1,0,0">
                <DataGrid.RowStyle>
                  <Style TargetType="DataGridRow">
                    <Setter Property="ToolTip" Value="{Binding Tiploc}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Runs}" Value="False">
                        <Setter Property="Foreground" Value="#9E9E9E" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*" MinWidth="60" ElementStyle="{StaticResource TrimCell}" />
                  <DataGridTextColumn Header="WTT" Binding="{Binding Booked}" Width="Auto" MinWidth="40" />
                  <DataGridTextColumn Header="Plan" Binding="{Binding Planned}" Width="Auto" MinWidth="40" />
                  <DataGridTextColumn Header="Actual" Binding="{Binding Actual}" Width="Auto" MinWidth="40" />
                  <DataGridTextColumn Header="Forecast" Binding="{Binding Forecast}" Width="Auto" MinWidth="40" Foreground="#1565C0" />
                  <DataGridTextColumn Header="vs WTT" Binding="{Binding WttDelay}" Width="Auto" MinWidth="36"
                                      HeaderStyle="{StaticResource RightHeader}" ElementStyle="{StaticResource DelayCell}" />
                  <DataGridTextColumn Header="vs plan" Binding="{Binding PlanDelay}" Width="Auto" MinWidth="36"
                                      HeaderStyle="{StaticResource RightHeader}" ElementStyle="{StaticResource DelayCell}" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>
          <TabItem Header="History" views:Help.Topic="{x:Static services:HelpTopics.History}">
            <DockPanel views:Help.Topic="{x:Static services:HelpTopics.History}">
              <DockPanel DockPanel.Dock="Top" Margin="6,4">
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="↷ Redo" Command="{Binding RedoCommand}"
                        ToolTip="{Binding RedoTip}" ToolTipService.ShowOnDisabled="True" />
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="↶ Undo" Command="{Binding UndoCommand}"
                        ToolTip="{Binding UndoTip}" ToolTipService.ShowOnDisabled="True" />
                <TextBlock Text="Edit history" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding History.Summary}" Foreground="#757575" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <ListBox x:Name="HistoryList" ItemsSource="{Binding History.Entries}" BorderThickness="0,1,0,0" HorizontalContentAlignment="Stretch"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Left" Text="{Binding Number, StringFormat={}{0}.}" Foreground="#9E9E9E" Width="26" />
                      <TextBlock DockPanel.Dock="Left" Text="⚠ " Foreground="#EF6C00" ToolTip="{Binding Warnings}"
                                 Visibility="{Binding Warnings, Converter={StaticResource NotNull}}" />
                      <TextBlock x:Name="EntryText" Text="{Binding Description}" TextWrapping="Wrap" />
                    </DockPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsUndone}" Value="True">
                        <Setter TargetName="EntryText" Property="Foreground" Value="#9E9E9E" />
                        <Setter TargetName="EntryText" Property="FontStyle" Value="Italic" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </TabItem>
        </TabControl>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
