<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows only (references the WPF app), so it is not in Stringline.Portable.slnf. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- Real cultures at run time, as the app has: WPF text needs them (the window tests lay out text). The build keeps
       InvariantGlobalization, so the culture analyser rules stay as in every other project. -->
  <Target Name="RealCulturesAtRunTime" BeforeTargets="GenerateBuildRuntimeConfigurationFiles">
    <ItemGroup>
      <RuntimeHostConfigurationOption Remove="System.Globalization.Invariant" />
      <RuntimeHostConfigurationOption Include="System.Globalization.Invariant" Value="false" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Stringline.App\Stringline.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Stringline.Gateway.Tests\FakeStompServer.cs" Link="FakeStompServer.cs" />
    <Compile Include="..\Stringline.Gateway.Tests\Fixtures.cs" Link="Fixtures.cs" />
  </ItemGroup>

</Project>
